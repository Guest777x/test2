-- INSTANT RESET
-- ============================================================
GD_ResetCD = false
GD_LastReset = 0
GD_ResetCam = nil
GD_ResetCamLock = false
function GD_InstantReset()
    local now = os.clock()
    if now - GD_LastReset < 0.75 or GD_ResetCD then return end
    GD_LastReset = now
    local c = LP.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health<=0 then return end
    GD_ResetCD = true
    _G.GD_InstaResetting = true
    local cam = workspace.CurrentCamera
    if cam then GD_ResetCam = cam.CFrame; GD_ResetCamLock = true end
    task.spawn(function()
        local savedHip = h.HipHeight
        local savedRot = h.AutoRotate
        local savedCol = {}
        local ok = false
        local attempts = 0
        while attempts<40 and c.Parent and h.Parent and h.Health>0 do
            if LP.Character~=c then ok=true; break end
            pcall(function()
                h.HipHeight = 1e30
                h.AutoRotate = true
                for _,p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then
                        if savedCol[p]==nil then savedCol[p]=p.CanCollide end
                        p.CanCollide = false
                    end
                end
            end)
            attempts += 1; task.wait(0.05)
        end
        if not ok and c.Parent and h.Parent and h.Health>0 and LP.Character==c then
            pcall(function() h.Health = 0 end)
            task.wait(0.15)
            ok = (not c.Parent) or (not h.Parent) or h.Health<=0 or LP.Character~=c
        else
            ok = ok or (not c.Parent) or (not h.Parent) or h.Health<=0 or LP.Character~=c
        end
        if not ok and c.Parent and h.Parent then
            pcall(function()
                h.HipHeight = savedHip
                h.AutoRotate = savedRot
                for p,cc in pairs(savedCol) do if p and p.Parent then p.CanCollide = cc end end
            end)
        end
        GD_ResetCamLock = false; GD_ResetCam = nil
        GD_ResetCD = false
        _G.GD_InstaResetting = false
    end)
end
task.spawn(function()
    while true do
        task.wait(0.016)
        local cam = workspace.CurrentCamera
        if GD_ResetCamLock and GD_ResetCam and cam then
            pcall(function() cam.CFrame = GD_ResetCam end)
        end
    end
end)

