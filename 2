GD_AppState = {headless=setmetatable({},{__mode="k"}), korblox=setmetatable({},{__mode="k"})}
function GD_SetHeadless(on, char)
    char = char or LP.Character
    local head = char and char:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end
    if on then
        if not GD_AppState.headless[char] then
            local s = {t=head.Transparency, ltm=head.LocalTransparencyModifier, faces={}}
            for _,i in ipairs(head:GetChildren()) do
                if i:IsA("Decal") or i:IsA("Texture") then table.insert(s.faces,{obj=i,t=i.Transparency}) end
            end
            GD_AppState.headless[char] = s
        end
        head.Transparency=1; head.LocalTransparencyModifier=1
        for _,i in ipairs(head:GetChildren()) do if i:IsA("Decal") or i:IsA("Texture") then i.Transparency=1 end end
    else
        local s = GD_AppState.headless[char]; if not s then return end
        if head.Parent then head.Transparency=s.t; head.LocalTransparencyModifier=s.ltm end
        for _,f in ipairs(s.faces) do if f.obj and f.obj.Parent then f.obj.Transparency=f.t end end
        GD_AppState.headless[char] = nil
    end
end
function GD_SetKorblox(on, char)
    char = char or LP.Character; if not char then return end
    local saved = GD_AppState.korblox[char]
    local function removeVisual()
        local old = char:FindFirstChild("GD_Korblox"); if old then old:Destroy() end
    end
    if not on then
        removeVisual()
        if saved then
            for _,ps in ipairs(saved.parts) do
                if ps.part and ps.part.Parent then ps.part.Transparency=ps.t; ps.part.LocalTransparencyModifier=ps.ltm end
            end
        end
        GD_AppState.korblox[char] = nil
        return
    end
    local target = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
    if not target or not target:IsA("BasePart") then return end
    local ok, objs = pcall(function() return game:GetObjects("rbxassetid://139607673") end)
    if not ok or type(objs)~="table" or not objs[1] then return end
    removeVisual()
    local visual = Instance.new("Model"); visual.Name="GD_Korblox"
    for _,o in ipairs(objs) do o.Parent = visual end
    local parts = {}
    for _,d in ipairs(visual:GetDescendants()) do if d:IsA("BasePart") then table.insert(parts, d) end end
    if #parts==0 then visual:Destroy(); return end
    if not saved then
        saved = {parts={}}
        for _,pn in ipairs({"LeftUpperLeg","LeftLowerLeg","LeftFoot","Left Leg"}) do
            local p = char:FindFirstChild(pn)
            if p and p:IsA("BasePart") then table.insert(saved.parts,{part=p,t=p.Transparency,ltm=p.LocalTransparencyModifier}) end
        end
        GD_AppState.korblox[char] = saved
    end
    visual.Parent = char
    for _,ps in ipairs(saved.parts) do
        if ps.part and ps.part.Parent then ps.part.Transparency=1; ps.part.LocalTransparencyModifier=1 end
    end
    for _,p in ipairs(parts) do
        local mt = char:FindFirstChild(p.Name)
        if not mt or not mt:IsA("BasePart") then mt = target end
        p.Anchored=false; p.CanCollide=false; p.Massless=true
        p.CFrame = mt.CFrame
        local w = Instance.new("WeldConstraint"); w.Part0=mt; w.Part1=p; w.Parent=p
    end
end

