AP_LEFT_HALF  = {Vector3.new(-476.48,-6.28,92.73), Vector3.new(-483.12,-4.95,94.8)}
AP_RIGHT_HALF = {Vector3.new(-476.16,-6.52,25.62), Vector3.new(-483.06,-5.03,25.48)}
alConn, arConn = nil, nil
pathMoveDir = Vector3.zero
function GD_PathApply(hrp, hum, dir, spd)
    if not hrp or not hum then return end
    if dir.Magnitude < 0.01 then
        GD_Speed.clear()
        pcall(function() hum:Move(Vector3.zero, false) end)
        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        return
    end
    local u = dir.Unit
    pcall(function()
        hum.AutoRotate = true
        hum:Move(Vector3.new(u.X,0,u.Z), false)
    end)
    GD_Speed.setXZ(hrp, u.X*spd, u.Z*spd)
end
function GD_DetectAutoSide()
    local plots = workspace:FindFirstChild("Plots"); if not plots then return "left" end
    for _,plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        local yb = sign and sign:FindFirstChild("YourBase")
        if yb and yb:IsA("BillboardGui") and yb.Enabled then
            local marker = plot:FindFirstChild("AnimalTarget", true)
            local pos = marker and marker.Position
            if not pos then local d = plot:FindFirstChild("DeliveryHitbox"); pos = d and d.Position end
            if pos then
                local dL = (pos - AP_LEFT_HALF[1]).Magnitude
                local dR = (pos - AP_RIGHT_HALF[1]).Magnitude
                return dL<=dR and "left" or "right"
            end
        end
    end
    return "left"
end
function GD_StopAutoPath(side)
    if side=="left" then
        if alConn then alConn:Disconnect(); alConn=nil end
        Config.AutoLeft = false
        if mobBtnRefs.autoLeft then pcall(mobBtnRefs.autoLeft, false) end
    else
        if arConn then arConn:Disconnect(); arConn=nil end
        Config.AutoRight = false
        if mobBtnRefs.autoRight then pcall(mobBtnRefs.autoRight, false) end
    end
    pathMoveDir = Vector3.zero
    local c = LP.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid"); local r = c:FindFirstChild("HumanoidRootPart")
        if h then pcall(function() h:Move(Vector3.zero, false) end) end
        if r then GD_Speed.clear() end
    end
end
stopAutoLeft = function() GD_StopAutoPath("left") end
stopAutoRight = function() GD_StopAutoPath("right") end
function GD_RunAutoPath(side)
    if side=="left" then
        if arConn then stopAutoRight() end
        if alConn then alConn:Disconnect(); alConn=nil end
        Config.AutoLeft = true; Config.AutoRight = false
    else
        if alConn then stopAutoLeft() end
        if arConn then arConn:Disconnect(); arConn=nil end
        Config.AutoRight = true; Config.AutoLeft = false
    end
    pathMoveDir = Vector3.zero
    local wps = (side=="right" and AP_RIGHT_HALF or AP_LEFT_HALF)
    local idx = 1
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local active = (side=="left" and Config.AutoLeft) or (side=="right" and Config.AutoRight)
        if not active then return end
        local c = LP.Character; if not c then return end
        local r = c:FindFirstChild("HumanoidRootPart"); local h = c:FindFirstChildOfClass("Humanoid")
        if not r or not h or h.Health<=0 then return end
        local target = wps[idx]; if not target then
            if side=="left" then stopAutoLeft() else stopAutoRight() end
            return
        end
        local fp = Vector3.new(r.Position.X,0,r.Position.Z)
        local ft = Vector3.new(target.X,0,target.Z)
        local d = (ft-fp).Magnitude
        if d<=1.1 then
            GD_PathApply(r,h,Vector3.zero,0)
            if idx>=#wps then
                if side=="left" then stopAutoLeft() else stopAutoRight() end
                return
            end
            idx += 1; return
        end
        local dir = ft-fp; if dir.Magnitude>0.001 then dir=dir.Unit else dir=Vector3.zero end
        pathMoveDir = dir
        local spd = GD_PathSpeed()
        if d<1.5 then spd = spd * math.clamp(d/1.5,0.6,1) end
        GD_PathApply(r,h,dir,spd)
    end)
    if side=="left" then alConn=conn else arConn=conn end
end
startAutoLeft = function() GD_RunAutoPath("left") end
startAutoRight = function() GD_RunAutoPath("right") end

