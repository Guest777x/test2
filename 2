    local pad=Instance.new("UIPadding")
    pad.PaddingLeft=UDim.new(0,4); pad.PaddingRight=UDim.new(0,10)
    pad.PaddingTop=UDim.new(0,4); pad.PaddingBottom=UDim.new(0,12)
    pad.Parent=p
    pages[n]=p; return p
end
