function GD_SetRowGlow(row, on)
    if not row then return end
    local st = row:FindFirstChild("RowStroke") or row:FindFirstChildOfClass("UIStroke")
    if not st then return end
    local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if on then
        TweenService:Create(st, info, {Transparency=0.05, Thickness=1.8, Color=THEME.Accent}):Play()
        TweenService:Create(row, info, {BackgroundColor3=THEME.Raised, BackgroundTransparency=0.3}):Play()
    else
        TweenService:Create(st, info, {Transparency=0.4, Thickness=1, Color=THEME.Border}):Play()
        TweenService:Create(row, info, {BackgroundColor3=THEME.Panel, BackgroundTransparency=0.5}):Play()
    end
end

function GD_KeybindBadge(parent, initial, offsetX, width, onChanged)
    local b=Instance.new("TextButton"); b.Text=tostring(initial or "None")
    b.Font=Enum.Font.GothamMedium; b.TextSize=11
    b.TextColor3=THEME.Text; b.BackgroundColor3=THEME.Raised; b.BackgroundTransparency=0.35
    b.BorderSizePixel=0; b.Size=UDim2.fromOffset(width or 46, 24)
    b.Position=UDim2.new(1,offsetX,0.5,-12); b.AutoButtonColor=false; b.Parent=parent
    GD_Corner(b,7); GD_Stroke(b,1,THEME.BorderSoft,0.35)
    local listening, current = false, tostring(initial or "None")
    b.Activated:Connect(function()
        if listening then return end
        listening = true; keybindCaptureActive = true; b.Text="…"
        local conn
        conn = UserInputService.InputBegan:Connect(function(i)
            local kb = i.UserInputType==Enum.UserInputType.Keyboard
            local gp = i.UserInputType.Name:match("^Gamepad%d+$") ~= nil
            if not (kb or gp) then return end
            current = (kb and i.KeyCode.Name=="Escape") and "None" or i.KeyCode.Name
            b.Text = current
            if onChanged then onChanged(current) end
            GD_SaveConfig()
            listening=false
            conn:Disconnect()
            task.defer(function() keybindCaptureActive=false end)
        end)
    end)
    return b, function() return current end
end

function GD_FormatNum(n)
    n = tonumber(n) or 0
    if math.abs(n - math.floor(n+1e-9)) < 1e-9 then return tostring(math.floor(n+0.5)) end
    return string.format("%.1f", n)
end

function GD_NumberBadge(parent, initial, offsetX, width, onChanged)
    local b=Instance.new("TextButton"); b.Text=GD_FormatNum(initial)
    b.Font=Enum.Font.GothamMedium; b.TextSize=11
    b.TextColor3=THEME.Text; b.BackgroundColor3=THEME.Raised; b.BackgroundTransparency=0.35
    b.BorderSizePixel=0; b.Size=UDim2.fromOffset(width or 44, 24)
    b.Position=UDim2.new(1,offsetX,0.5,-12); b.AutoButtonColor=false; b.Parent=parent
    GD_Corner(b,7); GD_Stroke(b,1,THEME.BorderSoft,0.35)
    local current = GD_FormatNum(initial)
    b.Activated:Connect(function()
        local box=Instance.new("TextBox")
        box.Text=current; box.Font=Enum.Font.GothamBold; box.TextSize=11
        box.TextColor3=THEME.Text; box.BackgroundColor3=THEME.Raised; box.BackgroundTransparency=0.2
        box.BorderSizePixel=0; box.Size=b.Size; box.Position=b.Position
        box.ClearTextOnFocus=false; box.TextXAlignment=Enum.TextXAlignment.Center
        box.Parent=parent; GD_Corner(box,7); GD_Stroke(box,1,THEME.Accent,0.2)
        b.Visible=false; box:CaptureFocus(); box.CursorPosition=#box.Text+1
        box.FocusLost:Connect(function()
            local num = tonumber((box.Text:gsub("%s+",""):gsub(",",".")))
            if num then
                num = math.floor(num*10+0.5)/10
                current = GD_FormatNum(num)
                if onChanged then onChanged(num) end
                GD_SaveConfig()
            end
            b.Text=current; box:Destroy(); b.Visible=true
        end)
    end)
    return b, function() return tonumber(current) or 0 end, function(v) current = GD_FormatNum(v); b.Text = current end
end

function GD_ToggleRow(parent, labelText, defaultOn, onToggle)
    local row = GD_Row(parent, labelText)
    local t = Instance.new("TextButton"); t.Text=""; t.AutoButtonColor=false
    t.Size=UDim2.fromOffset(42,22); t.Position=UDim2.new(1,-56,0.5,-11)
    t.BackgroundColor3=THEME.Raised; t.BackgroundTransparency=0.3; t.BorderSizePixel=0; t.Parent=row
    GD_Corner(t,11); local st = GD_Stroke(t,1.4,THEME.BorderSoft,0.3)
    local knob = Instance.new("Frame"); knob.Size=UDim2.fromOffset(16,16)
    knob.Position = defaultOn and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)
    knob.BackgroundColor3=THEME.Text; knob.BorderSizePixel=0; knob.Parent=t
    GD_Corner(knob,8)
    local on = defaultOn==true
    local function setVis(state)
        on = state==true
        local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(knob, info, {Position = on and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)}):Play()
        TweenService:Create(t, info, {BackgroundColor3 = on and THEME.Accent or THEME.Raised, BackgroundTransparency = on and 0.1 or 0.3}):Play()
        TweenService:Create(st, info, {Color = on and THEME.Accent or THEME.BorderSoft, Transparency = on and 0 or 0.3, Thickness = on and 1.8 or 1.4}):Play()
        GD_SetRowGlow(row, on)
    end
    t.Activated:Connect(function()
        setVis(not on)
        if onToggle then onToggle(on) end
        GD_SaveConfig()
    end)
    return row, setVis
end

