    GD_StopAutoSteal()
    task.delay(pause, function()
        if token~=Config._AutoStealHitToken then return end
        Config._AutoStealHitPauseUntil = 0
        if Config.AutoSteal and Config.AutoStealStopWhenHit then GD_StartAutoSteal() end
    end)
end
