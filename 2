-- ============================================================
function GD_LandingY(char, root, hum)
    local half = math.max(1, root.Size.Y*0.5)
    local off = half*3
    pcall(function()
        if hum.RigType==Enum.HumanoidRigType.R15 then off = half + (hum.HipHeight or half*2) end
    end)
    if off~=off or off<1 or off>12 then off = half*3 end
    local ignored = {char}
    for _,p in ipairs(Players:GetPlayers()) do if p~=LP and p.Character then table.insert(ignored,p.Character) end end
    local rp = RaycastParams.new(); rp.FilterDescendantsInstances = ignored
    pcall(function() rp.FilterType = Enum.RaycastFilterType.Exclude end)
    rp.IgnoreWater = true
    local castY = root.Position.Y - half - 0.1
    local floorY
    for _=1,12 do
        local hit = workspace:Raycast(Vector3.new(root.Position.X,castY,root.Position.Z), Vector3.new(0,-4000,0), rp)
        if not hit then break end
        local part = hit.Instance; local skip = false
        pcall(function()
            if part:IsA("BasePart") and not part.CanCollide then skip=true end
            local m = part:FindFirstAncestorOfClass("Model")
            if m and m:FindFirstChildOfClass("Humanoid") then skip=true end
        end)
        if not skip then floorY = hit.Position.Y; break end
        table.insert(ignored, part); rp.FilterDescendantsInstances = ignored
        castY = hit.Position.Y - 0.05
    end
    return floorY and (floorY+off+0.15) or -7
end

function GD_DoTPDown(force)
    local c = LP.Character; if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if not r or not h or h.Health<=0 then return end
    if not force then
        if h.FloorMaterial ~= Enum.Material.Air then return end
        if r.Position.Y < (tonumber(Config.TPDownHeight) or 20) then return end
    end
    local y = GD_LandingY(c, r, h)
    local _, yaw = r.CFrame:ToEulerAnglesYXZ()
    local v = r.AssemblyLinearVelocity
    r.CFrame = CFrame.new(r.Position.X, y, r.Position.Z) * CFrame.Angles(0,yaw,0)
    r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
    pcall(function() r.AssemblyAngularVelocity = Vector3.zero end)
end

