UserInputService.InputBegan:Connect(function(input, processed)
    if keybindCaptureActive then return end
    local isKb = input.UserInputType == Enum.UserInputType.Keyboard
    local isPad = input.UserInputType.Name:match("^Gamepad%d+$") ~= nil
    if not (isKb or isPad) then return end
    local key = input.KeyCode.Name
    local function is(k) return k and k~="" and key:upper()==tostring(k):upper() end
    if is(Config.HideUIKey) then if Config.HideUI then GD_Restore() else GD_Minimize() end; return end
    if is(Config.DropKey) then pcall(GD_RunDrop); return end
    if is(Config.TPDownKey) then if not processed then GD_DoTPDown(true) end; return end
    if is(Config.InstaResetKey) then if not processed then GD_InstantReset() end; return end
    if is(Config.CarrySpeedKey) then carrySpeedEnabled=not carrySpeedEnabled; if carrySpeedEnabled then laggerModeEnabled=false; laggerCarryEnabled=false end; return end
    if is(Config.LaggerKey) then
        if laggerModeEnabled then laggerModeEnabled=false; laggerCarryEnabled=true
        elseif laggerCarryEnabled then laggerCarryEnabled=false
        else laggerModeEnabled=true; laggerCarryEnabled=false end
        return
    end
    if is(Config.BatAimbotKey) then
        Config.BatAimbot = not Config.BatAimbot; State.autoBatToggled = Config.BatAimbot
        if Config.BatAimbot then GD_StartBatAimbot() else GD_StopBatAimbot() end
        if mobBtnRefs.autoBat then pcall(mobBtnRefs.autoBat, Config.BatAimbot) end
        GD_SaveConfig(); return
    end
    if is(Config.AutoPlayKey) and Config.AutoPlayMode=="1 Btn" then
        if Config.AutoLeft or Config.AutoRight then Config.AutoLeft=false; Config.AutoRight=false; if stopAutoLeft then stopAutoLeft() end; if stopAutoRight then stopAutoRight() end
        else local side=GD_DetectAutoSide(); if side=="left" then Config.AutoRight=false; if stopAutoRight then stopAutoRight() end; Config.AutoLeft=true; if startAutoLeft then startAutoLeft() end
        else Config.AutoLeft=false; if stopAutoLeft then stopAutoLeft() end; Config.AutoRight=true; if startAutoRight then startAutoRight() end end end
        return
    end
    if Config.AutoPlayMode=="2 Btn" then
        if is(Config.AutoLeftKey) then Config.AutoLeft=not Config.AutoLeft; if Config.AutoLeft then if stopAutoRight then stopAutoRight() end; if startAutoLeft then startAutoLeft() end else if stopAutoLeft then stopAutoLeft() end end; return end
        if is(Config.AutoRightKey) then Config.AutoRight=not Config.AutoRight; if Config.AutoRight then if stopAutoLeft then stopAutoLeft() end; if startAutoRight then startAutoRight() end else if stopAutoRight then stopAutoRight() end end; return end
    end
end)

