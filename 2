function GD_ApplyTheme(src)
    for k,v in pairs(src) do THEME[k]=v end
    main.BackgroundColor3 = THEME.Base
    brand.TextColor3 = THEME.Text
    tagline.TextColor3 = THEME.TextDim
    tagline.Text = Premium.active and "CRIMSON GLASS" or "MIDNIGHT GLASS"
    rail.BackgroundColor3 = THEME.Base
    for _,d in pairs(tabButtons) do
        local active = (d.lbl.Text == currentTab)
        d.btn.BackgroundColor3 = active and THEME.Accent or THEME.Panel
        d.lbl.TextColor3 = active and THEME.Text or THEME.TextDim
    end
    for _,o in ipairs(screenGui:GetDescendants()) do
        if o:IsA("UIStroke") and o:GetAttribute("GD_ThemeStroke") then
            o.Color = THEME.Border
        end
        if o:IsA("UIGradient") and o.Parent then
            local par = o.Parent
            if par.Name=="Main" or par:GetAttribute("GD_IsRow") or (par:IsA("Frame") and par:FindFirstChild("RowStroke")) then
                o.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, THEME.PanelTop),
                    ColorSequenceKeypoint.new(1, THEME.PanelBot),
                })
            end
        end
    end
    GD_UpdateBadge()
end

