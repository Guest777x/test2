function GD_SetRowGlow(row, on)
    if not row then return end
    local st=row:FindFirstChild("RowStroke") or row:FindFirstChildOfClass("UIStroke")
    if not st then return end
    local info=TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if on then
        TweenService:Create(st, info, {Transparency=0.05, Thickness=1.9, Color=THEME.Accent}):Play()
        TweenService:Create(row, info, {BackgroundColor3=THEME.Raised, BackgroundTransparency=0.12}):Play()
    else
        TweenService:Create(st, info, {Transparency=0.35, Thickness=1, Color=THEME.Border}):Play()
        TweenService:Create(row, info, {BackgroundColor3=THEME.Panel, BackgroundTransparency=0.2}):Play()
    end
end

function GD_KeybindBadge(parent, initial, offX, width, onChanged)
    local b=Instance.new("TextButton"); b.Text=tostring(initial or "None")
    b.Font=Enum.Font.GothamMedium; b.TextSize=11
    b.TextColor3=THEME.Text; b.BackgroundColor3=THEME.Raised; b.BackgroundTransparency=0.2
    b.BorderSizePixel=0; b.Size=UDim2.fromOffset(width or 48, 26)
    b.Position=UDim2.new(1,offX,0.5,-13); b.AutoButtonColor=false; b.Parent=parent
    GD_Corner(b,7); GD_Stroke(b,1,THEME.BorderSoft,0.3)
    local listening, current = false, tostring(initial or "None")
    b.Activated:Connect(function()
        if listening then return end
        listening=true; keybindCaptureActive=true; b.Text="…"
        TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3=THEME.Accent}):Play()
        local conn
        conn = UserInputService.InputBegan:Connect(function(i)
            local kb = i.UserInputType==Enum.UserInputType.Keyboard
            local gp = i.UserInputType.Name:match("^Gamepad%d+$") ~= nil
            if not (kb or gp) then return end
            current = (kb and i.KeyCode.Name=="Escape") and "None" or i.KeyCode.Name
            b.Text = current
            if onChanged then onChanged(current) end
            GD_SaveConfig(); listening=false
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3=THEME.Raised}):Play()
            conn:Disconnect()
            task.defer(function() keybindCaptureActive=false end)
        end)
    end)
    return b, function() return current end
end

function GD_FormatNum(n)
    n = tonumber(n) or 0
    if math.abs(n - math.floor(n+1e-9)) < 1e-9 then return tostring(math.floor(n+0.5)) end
    return string.format("%.1f", n)
end

function GD_NumberBadge(parent, initial, offX, width, onChanged)
    local b=Instance.new("TextButton"); b.Text=GD_FormatNum(initial)
    b.Font=Enum.Font.GothamMedium; b.TextSize=11
    b.TextColor3=THEME.Text; b.BackgroundColor3=THEME.Raised; b.BackgroundTransparency=0.2
    b.BorderSizePixel=0; b.Size=UDim2.fromOffset(width or 46, 26)
    b.Position=UDim2.new(1,offX,0.5,-13); b.AutoButtonColor=false; b.Parent=parent
    GD_Corner(b,7); GD_Stroke(b,1,THEME.BorderSoft,0.3)
    local current = GD_FormatNum(initial)
    b.Activated:Connect(function()
        local box=Instance.new("TextBox")
        box.Text=current; box.Font=Enum.Font.GothamBold; box.TextSize=11
        box.TextColor3=THEME.Text; box.BackgroundColor3=THEME.Raised
        box.BorderSizePixel=0; box.Size=b.Size; box.Position=b.Position
        box.ClearTextOnFocus=false; box.TextXAlignment=Enum.TextXAlignment.Center
        box.Parent=parent; GD_Corner(box,7); GD_Stroke(box,1,THEME.Accent,0.15)
        b.Visible=false; box:CaptureFocus(); box.CursorPosition=#box.Text+1
        box.FocusLost:Connect(function()
            local num = tonumber((box.Text:gsub("%s+",""):gsub(",",".")))
            if num then
                num = math.floor(num*10+0.5)/10
                current = GD_FormatNum(num)
                if onChanged then onChanged(num) end
                GD_SaveConfig()
            end
            b.Text=current; box:Destroy(); b.Visible=true
        end)
    end)
    return b, function() return tonumber(current) or 0 end, function(v) current=GD_FormatNum(v); b.Text=current end
end

