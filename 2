    local now = workspace:GetServerTimeNow()
    local endT = LP:GetAttribute("RagdollEndTime") or c:GetAttribute("RagdollEndTime") or h:GetAttribute("RagdollEndTime")
    if type(endT)=="number" and endT>now then return true end
    if LP:GetAttribute("Ragdolled")==true or LP:GetAttribute("Ragdoll")==true
        or c:GetAttribute("Ragdolled")==true or c:GetAttribute("Ragdoll")==true then return true end
