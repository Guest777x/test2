        for _,n in ipairs({"Carrying","IsCarrying","Grabbed","Holding","StealHold","HasGrab"}) do
            local x = c:FindFirstChild(n,true)
            if x and ((x:IsA("BoolValue") and x.Value) or (x:IsA("ObjectValue") and x.Value) or (x:IsA("StringValue") and x.Value~="")) then return true end
        end
        for _,x in ipairs(c:GetChildren()) do
            local n = x.Name:lower()
            if x:IsA("Model") and x:FindFirstChildWhichIsA("BasePart",true) then
                if n:find("brainrot") or n:find("animal") or n:find("carry") or n:find("grab") then return true end
            end
        end
        return false
    end
    local function enable() state.waiting=false; state.applied=true; state.graceUntil=tick()+0.75; autoCarryBoost=true end
    local function disable() state.applied=false; state.waiting=false; state.graceUntil=0; autoCarryBoost=false end
    _GACC.disableAutoCarry = disable
    RunService.RenderStepped:Connect(function()
        if not Config.AutoCarrySpeed then if state.applied or autoCarryBoost then disable() end; return end
        local c = LP.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
        if not c or not h then disable(); state.stealWasActive=false; return end
        local st = h:GetState()
        local hit = st==Enum.HumanoidStateType.Physics or st==Enum.HumanoidStateType.Ragdoll or st==Enum.HumanoidStateType.FallingDown
        local stealing = LP:GetAttribute("Stealing")==true or c:GetAttribute("Stealing")==true
        local carrying = _GACC.autoCarryDetect()
        if stealing and not state.stealWasActive then state.stealWasActive=true; enable()
        elseif not stealing then state.stealWasActive=false end
        if carrying and not state.applied then enable() end
        if state.applied and (hit or (tick()>state.graceUntil and not carrying and not stealing)) then disable() end
    end)
end

-- Drop
DROP_ASC=0.22; DROP_SPD=160
function GD_RunDrop()
    if dropActive then return end
    local c = LP.Character; if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart"); if not r then return end
    dropActive = true; local t0 = tick(); local conn
    conn = RunService.Heartbeat:Connect(function()
        local cc = LP.Character; local rr = cc and cc:FindFirstChild("HumanoidRootPart")
        if not rr or not dropActive then if conn then conn:Disconnect() end; dropActive=false; return end
        if tick()-t0 >= DROP_ASC then
            conn:Disconnect()
            pcall(function()
                local rp = RaycastParams.new(); rp.FilterDescendantsInstances={cc}; rp.FilterType=Enum.RaycastFilterType.Exclude
                local hit = workspace:Raycast(rr.Position, Vector3.new(0,-3000,0), rp)
                if hit then
                    local hum = cc:FindFirstChildOfClass("Humanoid")
                    local off = ((hum and hum.HipHeight) or 2)+(rr.Size.Y/2)
                    rr.CFrame = CFrame.new(rr.Position.X, hit.Position.Y+off, rr.Position.Z)
                    rr.AssemblyLinearVelocity = Vector3.zero
                end
            end)
            dropActive=false; return
        end
        local v = rr.AssemblyLinearVelocity
        rr.AssemblyLinearVelocity = Vector3.new(v.X, DROP_SPD, v.Z)
    end)
end

-- Bat Aimbot
Conns = { aimbot = nil }
function GD_StartBatAimbot()
    if Config.SafeMode and _GACC and _GACC.autoCarryDetect and _GACC.autoCarryDetect() then return end
    if Conns.aimbot then Conns.aimbot:Disconnect(); Conns.aimbot=nil end
    State.autoBatToggled = true
    local hitCD=false; local lockedChar=nil
    local HIT_DIST=8; local SWING_CD=0.35
    local function findBat()
        local c = LP.Character; if not c then return nil end
        for _,t in ipairs(c:GetChildren()) do if t:IsA("Tool") then local n=t.Name:lower(); if n:find("bat") or n:find("slap") then return t end end end
        local bp = LP:FindFirstChildOfClass("Backpack")
        if bp then for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then local n=t.Name:lower(); if n:find("bat") or n:find("slap") then return t end end end end
        return nil
    end
    local function trySwing()
        if hitCD then return end
        if not (Config.AutoSwing and Config.BatAimbot and State.autoBatToggled) then return end
        hitCD = true
        pcall(function()
            local c = LP.Character; if not c then return end
            local bat = findBat(); if not bat then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if bat.Parent~=c and h then pcall(function() h:EquipTool(bat) end) end
            pcall(function() bat:Activate() end)
        end)
        task.delay(SWING_CD, function() hitCD=false end)
    end
    local function valid(c)
        if not c or not c.Parent then return false end
        local h = c:FindFirstChildOfClass("Humanoid"); local r = c:FindFirstChild("HumanoidRootPart")
        return h and r and h.Health>0
    end
    local function closest(root)
        if lockedChar and not valid(lockedChar) then lockedChar=nil end
        if lockedChar then local r = lockedChar:FindFirstChild("HumanoidRootPart"); if r then return r,(r.Position-root.Position).Magnitude end; lockedChar=nil end
        local best, bd, bc = nil, math.huge, nil
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LP and valid(p.Character) then
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                local d = (r.Position-root.Position).Magnitude
                if d<bd then bd=d; best=r; bc=p.Character end
            end
        end
        lockedChar = bc; return best, bd
    end
    local hum0 = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum0 then hum0.AutoRotate = false end
    Conns.aimbot = RunService.RenderStepped:Connect(function()
        if not State.autoBatToggled then return end
        local c = LP.Character; if not c then return end
        local r = c:FindFirstChild("HumanoidRootPart"); if not r then return end
        local h = c:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then return end
        h.AutoRotate = false
        if not c:FindFirstChildOfClass("Tool") then local b=findBat(); if b then pcall(function() h:EquipTool(b) end) end end
        local target, dist = closest(r); if not target then return end
        local myPos=r.Position
        local tv=target.AssemblyLinearVelocity; local look=target.CFrame.LookVector
        local pred = target.Position + tv*0.14 + look*0.3
        local lead = pred-target.Position; if lead.Magnitude>7.5 then pred = target.Position + lead.Unit*7.5 end
        local tf = Vector3.new(look.X,0,look.Z)
        if tf.Magnitude<0.001 then local fb=target.CFrame.RightVector; tf=Vector3.new(-fb.X,0,-fb.Z) end
        if tf.Magnitude>0 then tf=tf.Unit else tf=Vector3.new(0,0,-1) end
        local chase = pred + tf*3.5
        local dir = chase - myPos; local flat = Vector3.new(dir.X,0,dir.Z)
        if flat.Magnitude>0 then flat=flat.Unit else flat=Vector3.zero end
        local spd = math.clamp(Config.AimbotSpeed or 55, 1, 120)
        local desiredY = chase.Y + 3.7; local yVel = (desiredY-myPos.Y)*19.5
        if h.FloorMaterial~=Enum.Material.Air then yVel=math.max(yVel,13) end
        yVel = math.clamp(yVel,-70,110)
        local dv = Vector3.new(flat.X*spd, yVel, flat.Z*spd)
        r.AssemblyLinearVelocity = r.AssemblyLinearVelocity:Lerp(dv, 0.8)
        local travel = Vector3.new(tv.X,0,tv.Z)
        if travel.Magnitude>1.25 then travel=travel.Unit else travel=tf end
        local face = myPos + travel*10
        if (face-myPos).Magnitude>0.1 then r.CFrame = CFrame.lookAt(myPos, face); r.AssemblyAngularVelocity = Vector3.zero end
        if dist<=HIT_DIST then trySwing() end
    end)
end
function GD_StopBatAimbot()
    if Conns.aimbot then Conns.aimbot:Disconnect(); Conns.aimbot=nil end
    State.autoBatToggled = false
    local c = LP.Character; local r = c and c:FindFirstChild("HumanoidRootPart")
    if r then r.AssemblyLinearVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero end
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then h.AutoRotate=true; h.PlatformStand=false; pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
end

