    if not atmo then
        atmo = Instance.new("Atmosphere"); atmo.Parent=Lighting; AntiLagState.beauty.atmo = atmo
    end
    atmo.Density=0.28; atmo.Color=Color3.fromRGB(255,190,210); atmo.Decay=Color3.fromRGB(120,90,160); atmo.Glare=0.35; atmo.Haze=1.6
    Lighting.Ambient=Color3.fromRGB(95,70,110); Lighting.OutdoorAmbient=Color3.fromRGB(140,110,150)
    Lighting.ColorShift_Top=Color3.fromRGB(255,200,230); Lighting.ColorShift_Bottom=Color3.fromRGB(80,60,120)
    Lighting.Brightness=2.15; Lighting.GlobalShadows=false
    Lighting.FogColor=Color3.fromRGB(200,160,190); Lighting.FogStart=40; Lighting.FogEnd=520
    Lighting.ClockTime=19.35
end
function GD_EnableAntiLag()
    if AntiLagState.active then return end
    AntiLagState.active = true; AntiLagState.cache = {}
    AntiLagState.lighting = {
        GlobalShadows=Lighting.GlobalShadows, FogEnd=Lighting.FogEnd, FogStart=Lighting.FogStart,
        FogColor=Lighting.FogColor, Brightness=Lighting.Brightness, Ambient=Lighting.Ambient,
        OutdoorAmbient=Lighting.OutdoorAmbient, ColorShift_Top=Lighting.ColorShift_Top,
        ColorShift_Bottom=Lighting.ColorShift_Bottom, ClockTime=Lighting.ClockTime,
    }
    for _,c in ipairs(Lighting:GetChildren()) do
        if c:IsA("PostEffect") then AntiLagState.effects[c]=c.Enabled; pcall(function() c.Enabled=false end) end
    end
    GD_ALEmotion()
    if AntiLagState.conn then AntiLagState.conn:Disconnect() end
    AntiLagState.conn = workspace.DescendantAdded:Connect(function(d)
        if AntiLagState.active then GD_ALObj(d) end
    end)
    task.spawn(function()
        local ds = workspace:GetDescendants()
        for i=1,#ds do
            if not AntiLagState.active then break end
            GD_ALObj(ds[i])
            if i%220==0 then task.wait() end
        end
    end)
end
function GD_DisableAntiLag()
    AntiLagState.active = false
    if AntiLagState.conn then AntiLagState.conn:Disconnect(); AntiLagState.conn=nil end
    GD_ALClearBeauty()
    for inst, props in pairs(AntiLagState.cache) do
        if inst and inst.Parent then
            for k,v in pairs(props) do pcall(function() inst[k]=v end) end
        end
    end
    table.clear(AntiLagState.cache)
    for eff, on in pairs(AntiLagState.effects) do if eff and eff.Parent then pcall(function() eff.Enabled=on end) end end
    table.clear(AntiLagState.effects)
    if AntiLagState.lighting then
        for k,v in pairs(AntiLagState.lighting) do pcall(function() Lighting[k]=v end) end
        AntiLagState.lighting = nil
    end
end

