        local info=TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(knob, info, {Position = on and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)}):Play()
        TweenService:Create(t, info, {BackgroundColor3 = on and THEME.Accent or THEME.Raised}):Play()
        TweenService:Create(st, info, {Color = on and THEME.Accent or THEME.BorderSoft, Transparency = on and 0 or 0.3, Thickness = on and 1.9 or 1.4}):Play()
        GD_SetRowGlow(row, on)
    end
    t.Activated:Connect(function()
        if premium and not GD_PremiumAllowed() then GD_OpenTrialPrompt(); return end
        setVis(not on)
        if onToggle then onToggle(on) end
        GD_SaveConfig()
    end)
    if on then setVis(true) end
    return row, setVis
end

