    l.Size=UDim2.new(0.55,0,1,0); l.Position=UDim2.new(0,14,0,0)
    l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=r
    r.MouseEnter:Connect(function() TweenService:Create(r,TweenInfo.new(0.12),{BackgroundTransparency=0.35}):Play() end)
    r.MouseLeave:Connect(function() TweenService:Create(r,TweenInfo.new(0.14),{BackgroundTransparency=0.45}):Play() end)
    if premium then
        table.insert(premiumRows, r)
        r.Visible = GD_PremiumAllowed()
    end
    return r
end

function GD_SetRowGlow(row, on)
    if not row then return end
    local st = row:FindFirstChild("RowStroke") or row:FindFirstChildOfClass("UIStroke")
    if not st then return end
    local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if on then
        TweenService:Create(st, info, {Transparency=0.05, Thickness=1.9, Color=THEME.Accent}):Play()
        TweenService:Create(row, info, {BackgroundColor3=THEME.Raised, BackgroundTransparency=0.28}):Play()
    else
        TweenService:Create(st, info, {Transparency=0.4, Thickness=1, Color=THEME.Border}):Play()
        TweenService:Create(row, info, {BackgroundColor3=THEME.Panel, BackgroundTransparency=0.45}):Play()
    end
end

function GD_KeybindBadge(parent, initial, offsetX, width, onChanged)
    local b=Instance.new("TextButton"); b.Text=tostring(initial or "None")
    b.Font=Enum.Font.GothamMedium; b.TextSize=11
    b.TextColor3=THEME.Text; b.BackgroundColor3=THEME.Raised; b.BackgroundTransparency=0.35
    b.BorderSizePixel=0; b.Size=UDim2.fromOffset(width or 48, 26)
    b.Position=UDim2.new(1,offsetX,0.5,-13); b.AutoButtonColor=false; b.Parent=parent
    GD_Corner(b,8); GD_Stroke(b,1,THEME.BorderSoft,0.35)
    local listening, current = false, tostring(initial or "None")
    b.Activated:Connect(function()
        if listening then return end
        listening=true; keybindCaptureActive=true; b.Text="…"
        TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3=THEME.Accent, BackgroundTransparency=0.1}):Play()
        local conn
        conn = UserInputService.InputBegan:Connect(function(i)
            local kb = i.UserInputType==Enum.UserInputType.Keyboard
            local gp = i.UserInputType.Name:match("^Gamepad%d+$") ~= nil
            if not (kb or gp) then return end
            current = (kb and i.KeyCode.Name=="Escape") and "None" or i.KeyCode.Name
            b.Text = current
            if onChanged then onChanged(current) end
            GD_SaveConfig(); listening=false
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3=THEME.Raised, BackgroundTransparency=0.35}):Play()
            conn:Disconnect()
            task.defer(function() keybindCaptureActive=false end)
        end)
    end)
    return b, function() return current end
end

function GD_FormatNum(n)
    n = tonumber(n) or 0
    if math.abs(n - math.floor(n+1e-9)) < 1e-9 then return tostring(math.floor(n+0.5)) end
    return string.format("%.1f", n)
end

