-- Input dispatch (single handler, all keys)
UserInputService.InputBegan:Connect(function(input, processed)
    if keybindCaptureActive then return end
    local isKb = input.UserInputType == Enum.UserInputType.Keyboard
    local isPad = input.UserInputType.Name:match("^Gamepad%d+$") ~= nil
    if not (isKb or isPad) then return end
    local key = input.KeyCode.Name
    local function is(k) return k and k ~= "" and key:upper() == tostring(k):upper() end
    if is(Config.DropKey) then GD_RunDrop(); return end
    if is(Config.TPDownKey) then if not processed then GD_DoTPDown(true) end; return end
    if is(Config.InstaResetKey) then if not processed then GD_InstantReset() end; return end
    if is(Config.CarrySpeedKey) then
        carrySpeedEnabled = not carrySpeedEnabled
        if carrySpeedEnabled then laggerCarryEnabled = false; laggerModeEnabled = false end
        return
    end
    if is(Config.LaggerKey) then
        if laggerModeEnabled then laggerModeEnabled = false; laggerCarryEnabled = true
        elseif laggerCarryEnabled then laggerCarryEnabled = false
        else laggerModeEnabled = true; laggerCarryEnabled = false end
        return
    end
    if is(Config.BatAimbotKey) then
        Config.BatAimbot = not Config.BatAimbot
        State.autoBatToggled = Config.BatAimbot
        if Config.BatAimbot then GD_StartBatAimbot() else GD_StopBatAimbot() end
        return
    end
    if is(Config.HideUIKey) then
        if Config.HideUI then GD_Restore() else GD_Minimize() end
    end
end)

-- Restore active toggles on script load
task.defer(function()
    task.wait(0.3)
    if Config.NoCamCollision then GD_StartNoCamCollision() end
    if Config.AntiRagdoll then
        if Config.AntiRagdollMode == "V2" then GD_StartAntiRagdollV2() else GD_StartAntiRagdollV1() end
    end
    if Config.BatCounter then GD_StartBatCounter() end
    if Config.MedusaCounter then GD_StartMedusaCounter() end
    if Config.AntiDie then GD_StartAntiDie() end
    if Config.Spin then GD_StartSpin() end
    if Config.PlayerESP then GD_StartESP() end
    if Config.AutoSteal then GD_StartAutoSteal() end
    if Config.AutoTPDown then GD_StartAutoTPDown() end
    if Config.AntiLag then GD_EnableAntiLag() end
    if Config.StretchRes then GD_EnableStretch() end
    if Config.FOVChange then GD_EnableFOV() end
end)

