    b.Font=Enum.Font.GothamMedium; b.TextSize=11
    b.TextColor3=THEME.Text; b.BackgroundColor3=THEME.Raised; b.BackgroundTransparency=0.35
    b.BorderSizePixel=0; b.Size=UDim2.fromOffset(width or 46, 26)
    b.Position=UDim2.new(1,offsetX,0.5,-13); b.AutoButtonColor=false; b.Parent=parent
    GD_Corner(b,8); GD_Stroke(b,1,THEME.BorderSoft,0.35)
    local current = GD_FormatNum(initial)
    b.Activated:Connect(function()
        local box=Instance.new("TextBox")
