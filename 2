-- SPEED (VyzeSpeed-equivalent)
-- ============================================================
GD_Speed = {}
do
    local S = { spoofed=Vector3.zero, root=nil, hooked=false, plane=Vector2.zero, lastMoveDir=Vector3.zero }
    local MK = {[Enum.KeyCode.W]=true,[Enum.KeyCode.A]=true,[Enum.KeyCode.S]=true,[Enum.KeyCode.D]=true,
        [Enum.KeyCode.Up]=true,[Enum.KeyCode.Left]=true,[Enum.KeyCode.Down]=true,[Enum.KeyCode.Right]=true}
    local function ragdoll(h)
        if not h then return true end
        local st = h:GetState()
        return h.PlatformStand or st==Enum.HumanoidStateType.Physics or st==Enum.HumanoidStateType.Ragdoll or st==Enum.HumanoidStateType.FallingDown
    end
    local function apply(hrp,x,z)
        if not hrp or not hrp.Parent then return end
        local y = hrp.AssemblyLinearVelocity.Y
        hrp.AssemblyLinearVelocity = Vector3.new(x,y,z)
        local vis = math.min(math.sqrt(x*x+z*z),20)
        if vis > 0.05 then
            local u = Vector3.new(x,0,z); if u.Magnitude>0.001 then u=u.Unit end
            S.spoofed = Vector3.new(u.X*vis, y, u.Z*vis)
        else S.spoofed = Vector3.new(0,y,0) end
        S.plane = Vector2.new(x,z)
    end
    local function run(spd)
        local c = LP.Character; if not c then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        local r = c:FindFirstChild("HumanoidRootPart")
        if not h or not r or h.Health<=0 then return end
        if State.autoBatToggled or Config.AutoLeft or Config.AutoRight or dropActive then return end
        if ragdoll(h) then S.lastMoveDir = Vector3.zero; return end
        S.root = r
        local dir = nil
        if h.MoveDirection.Magnitude>0 then S.lastMoveDir=h.MoveDirection; dir=h.MoveDirection
        elseif S.lastMoveDir.Magnitude>0 then
            for k in pairs(MK) do if UserInputService:IsKeyDown(k) then dir=S.lastMoveDir; break end end
        end
        if dir and dir.Magnitude>0.05 then
            pcall(function() if r.SetNetworkOwner then r:SetNetworkOwner(LP) end end)
            local u = dir.Unit; local y = r.AssemblyLinearVelocity.Y
            r.AssemblyLinearVelocity = Vector3.new(u.X*spd, y, u.Z*spd)
            local vis = math.min(spd,20)
            S.spoofed = Vector3.new(u.X*vis, y, u.Z*vis)
            S.plane = Vector2.new(u.X*spd, u.Z*spd)
            S.lastMoveDir = u
        else
            local y = r.AssemblyLinearVelocity.Y
            r.AssemblyLinearVelocity = Vector3.new(0,y,0)
            S.spoofed = Vector3.new(0,y,0); S.plane = Vector2.zero
        end
    end
    pcall(function()
        if not (getrawmetatable and setreadonly and newcclosure and checkcaller) then return end
        if S.hooked then return end
        local mt = getrawmetatable(game); if not mt then return end
        setreadonly(mt, false)
        local oi, oni = mt.__index, mt.__newindex
        local function mine(t,k)
            local tk = tostring(k)
            if tk~="AssemblyLinearVelocity" and tk~="Velocity" then return false end
            if typeof(t)~="Instance" or not t:IsA("BasePart") then return false end
            local n = t.Name
            if n~="HumanoidRootPart" and n~="Torso" and n~="UpperTorso" then return false end
            local c = LP.Character
            return c~=nil and t:IsDescendantOf(c)
        end
        if type(oi)=="function" or type(oi)=="table" then
            mt.__index = newcclosure(function(self,k)
                if not checkcaller() then local ok,m=pcall(mine,self,k); if ok and m then return S.spoofed end end
                if type(oi)=="function" then return oi(self,k) end
                return oi[k]
            end)
        end
        if type(oni)=="function" then
            mt.__newindex = newcclosure(function(self,k,v)
                if not checkcaller() then local ok,m=pcall(mine,self,k); if ok and m then S.spoofed=v; return end end
                return oni(self,k,v)
            end)
        end
        setreadonly(mt, true); S.hooked = true
    end)
    GD_Speed.apply = run
    GD_Speed.getPlane = function() return S.plane end
    GD_Speed.clear = function()
        local c=LP.Character; local r=c and c:FindFirstChild("HumanoidRootPart")
        if r then local y=r.AssemblyLinearVelocity.Y; r.AssemblyLinearVelocity=Vector3.new(0,y,0) end
        S.plane = Vector2.zero
    end
    GD_Speed.setXZ = function(hrp,x,z) apply(hrp,x,z) end
end

