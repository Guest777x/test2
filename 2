function GD_CycleRow(parent, labelText, options, currentValue, onChanged)
    local row = GD_Row(parent, labelText)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency=1; lbl.Size=UDim2.fromOffset(110,22)
    lbl.Position=UDim2.new(1,-146,0.5,-11)
    lbl.Font=Enum.Font.GothamBold; lbl.TextSize=12; lbl.TextColor3=THEME.Text
    lbl.Text=tostring(currentValue); lbl.TextXAlignment=Enum.TextXAlignment.Center
    lbl.TextTruncate=Enum.TextTruncate.AtEnd; lbl.Parent=row
    local idx = 1
    for i,o in ipairs(options) do if o==currentValue then idx=i break end end
    local function arrow(txt, x)
        local b=Instance.new("TextButton"); b.Size=UDim2.fromOffset(24,22)
        b.Position=UDim2.new(1,x,0.5,-11)
        b.BackgroundColor3=THEME.Raised; b.BackgroundTransparency=0.3; b.BorderSizePixel=0
        b.Text=txt; b.Font=Enum.Font.GothamBlack; b.TextSize=13; b.TextColor3=THEME.Text
        b.AutoButtonColor=false; b.Parent=row; GD_Corner(b,6); return b
    end
    local function setIdx(i)
