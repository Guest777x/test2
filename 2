        btn.InputBegan:Connect(function(i) if Config.LockUI then return end; if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dg=true; ds=i.Position; sp=btn.Position end end)
        UserInputService.InputChanged:Connect(function(i)
            if not dg or not ds or not sp then return end
            if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then local d=i.Position-ds; btn.Position=UDim2.new(sp.X.Scale, sp.X.Offset+d.X, sp.Y.Scale, sp.Y.Offset+d.Y) end
        end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then if dg then dg=false; if not Config.LockUI then GD_SaveMobPos() end end end end)
    end
    for _,def in ipairs(defs) do
        local btn=Instance.new("TextButton"); btn.Name=def.key
        btn.Size=UDim2.fromOffset(W,H); local pos=defaultPos(def)
        if type(saved[def.key])=="table" then
            local sx,sy,ox,oy=tonumber(saved[def.key].sx),tonumber(saved[def.key].sy),tonumber(saved[def.key].ox),tonumber(saved[def.key].oy)
            if sx and sy and ox and oy then pos=UDim2.new(sx,ox,sy,oy) end
        end
        btn.Position=pos; btn.BackgroundColor3=OFF; btn.TextColor3=Color3.new(1,1,1)
        btn.Font=Enum.Font.GothamBlack; btn.TextSize=math.max(10, math.floor(12*scale))
        btn.TextWrapped=true; btn.Text=def.label
        btn.AutoButtonColor=false; btn.BorderSizePixel=0; btn.Parent=gui; GD_Corner(btn, rad)
        local st=Instance.new("UIStroke"); st.Color=THEME.Accent; st.Thickness=1.8; st.Transparency=0.05
        st.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; st.Parent=btn
        makeDrag(btn); mobBtnFrames[def.key]=btn
        local active=false
        local function setV(on) active=on==true; setVisual(btn, active) end
        mobBtnRefs[def.key]=setV
        btn.Activated:Connect(function()
            if def.key=="reset" then setV(true); GD_InstantReset(); task.delay(0.6, function() setV(false) end)
            elseif def.key=="drop" then setV(true); GD_RunDrop(); task.spawn(function() while dropActive do task.wait() end; setV(false) end)
            elseif def.key=="tpDown" then setV(true); GD_DoTPDown(true); task.delay(0.25, function() setV(false) end)
            elseif def.key=="autoBat" then State.autoBatToggled=not State.autoBatToggled; Config.BatAimbot=State.autoBatToggled; if State.autoBatToggled then GD_StartBatAimbot() else GD_StopBatAimbot() end; setV(State.autoBatToggled); GD_SaveConfig()
            elseif def.key=="carrySpeed" then carrySpeedEnabled=not carrySpeedEnabled; if carrySpeedEnabled then laggerModeEnabled=false; laggerCarryEnabled=false; if mobBtnRefs.lagger then mobBtnRefs.lagger(false) end; if mobBtnRefs.laggerCarry then mobBtnRefs.laggerCarry(false) end end; setV(carrySpeedEnabled); GD_SaveConfig()
            elseif def.key=="lagger" then laggerModeEnabled=not laggerModeEnabled; if laggerModeEnabled then carrySpeedEnabled=false; laggerCarryEnabled=false; if mobBtnRefs.carrySpeed then mobBtnRefs.carrySpeed(false) end; if mobBtnRefs.laggerCarry then mobBtnRefs.laggerCarry(false) end end; setV(laggerModeEnabled); GD_SaveConfig()
            elseif def.key=="laggerCarry" then laggerCarryEnabled=not laggerCarryEnabled; if laggerCarryEnabled then carrySpeedEnabled=false; laggerModeEnabled=false; if mobBtnRefs.carrySpeed then mobBtnRefs.carrySpeed(false) end; if mobBtnRefs.lagger then mobBtnRefs.lagger(false) end end; setV(laggerCarryEnabled); GD_SaveConfig()
            elseif def.key=="autoPlay" then
                if Config.AutoLeft or Config.AutoRight then Config.AutoLeft=false; Config.AutoRight=false; if stopAutoLeft then stopAutoLeft() end; if stopAutoRight then stopAutoRight() end; setV(false)
                else local side=GD_DetectAutoSide(); if side=="left" then Config.AutoRight=false; if stopAutoRight then stopAutoRight() end; Config.AutoLeft=true; if startAutoLeft then startAutoLeft() end
                else Config.AutoLeft=false; if stopAutoLeft then stopAutoLeft() end; Config.AutoRight=true; if startAutoRight then startAutoRight() end end; setV(true) end; GD_SaveConfig()
            elseif def.key=="autoLeft" then Config.AutoLeft=not Config.AutoLeft; if Config.AutoLeft then if stopAutoRight then stopAutoRight() end; if startAutoLeft then startAutoLeft() end else if stopAutoLeft then stopAutoLeft() end end; setV(Config.AutoLeft); GD_SaveConfig()
            elseif def.key=="autoRight" then Config.AutoRight=not Config.AutoRight; if Config.AutoRight then if stopAutoLeft then stopAutoLeft() end; if startAutoRight then startAutoRight() end else if stopAutoRight then stopAutoRight() end end; setV(Config.AutoRight); GD_SaveConfig() end
        end)
    end
    if Config.AutoLeft and mobBtnRefs.autoPlay then mobBtnRefs.autoPlay(true) end
    if Config.AutoLeft and mobBtnRefs.autoLeft then mobBtnRefs.autoLeft(true) end
    if Config.AutoRight and mobBtnRefs.autoRight then mobBtnRefs.autoRight(true) end
