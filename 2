    GD_Corner(cancelBtn,8)
    cancelBtn.Activated:Connect(function() dlg:Destroy() end)
end

function GD_StartTrial()
    if Premium.isTrial or Config.PremiumUnlocked then return end
    Premium.active = true
    Premium.isTrial = true
    Premium.trialEndsAt = tick() + Premium.trialDuration
    GD_ApplyTheme(THEMES.Crimson)
    GD_ShowPremiumRows(true)
    GD_UpdateBadge()
    trialTimer.Visible = true
    task.spawn(function()
        while Premium.isTrial and tick() < Premium.trialEndsAt do
            local left = math.max(0, Premium.trialEndsAt - tick())
            trialTimer.Text = string.format("TRIAL %.1fs", left)
            task.wait(0.1)
        end
        if Premium.isTrial then GD_EndTrial() end
    end)
end

function GD_EndTrial()
    if not Premium.isTrial then return end
    Premium.isTrial = false
    Premium.active = Config.PremiumUnlocked == true
    trialTimer.Visible = false
    GD_ApplyTheme(THEMES.Midnight)
    GD_ShowPremiumRows(Config.PremiumUnlocked == true)
    if Config.Spin then Config.Spin=false; GD_StopSpin() end
    if Config.CustomAnim then Config.CustomAnim=false; pcall(GD_RestoreAnims, LP.Character) end
    if Config.AntiLag then Config.AntiLag=false; GD_DisableAntiLag() end
    if Config.StretchRes then Config.StretchRes=false; GD_DisableStretch() end
    if Config.FOVChange then Config.FOVChange=false; GD_DisableFOV() end
    if Config.Headless then Config.Headless=false; pcall(GD_SetHeadless, false, LP.Character) end
    if Config.Korblox then Config.Korblox=false; pcall(GD_SetKorblox, false, LP.Character) end
    GD_SaveConfig()
    GD_ShowPremiumNotification()
end

