    for _, opt in ipairs(options) do
        local b = Instance.new("TextButton")
        b.Text = opt
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.TextColor3 = THEME.Text
        b.AutoButtonColor = false
        b.Size = UDim2.new(1/n, -math.floor(4*(n-1)/n), 1, 0)
        b.BackgroundColor3 = opt == current and THEME.Accent or THEME.Panel
        b.BackgroundTransparency = opt == current and 0.1 or 0.5
        b.BorderSizePixel = 0
        b.Parent = row
