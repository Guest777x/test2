-- PRIMITIVES
-- ============================================================
function GD_Corner(parent, radius)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, radius or 8); c.Parent = parent; return c
end
function GD_Stroke(parent, thickness, color, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Color = color or THEME.Border
    s.Transparency = transparency or THEME.StrokeTrans
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    s:SetAttribute("GD_ThemeStroke", true)
    return s
end
function GD_Padding(parent, l, r, t, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0); p.PaddingRight = UDim.new(0, r or 0)
    p.PaddingTop = UDim.new(0, t or 0);  p.PaddingBottom = UDim.new(0, b or 0)
    p.Parent = parent; return p
end
function GD_GlassGradient(parent)
    local g = Instance.new("UIGradient")
    g.Rotation = 90
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, THEME.PanelTop),
        ColorSequenceKeypoint.new(1, THEME.PanelBot),
    })
    g.Parent = parent
    return g
end
function GD_ApplyGlassStyle(frame, radius, transparency)
    frame.BackgroundColor3 = THEME.Panel
    frame.BackgroundTransparency = transparency or THEME.GlassTrans
    frame.BorderSizePixel = 0
    GD_Corner(frame, radius or 12)
    GD_GlassGradient(frame)
    GD_Stroke(frame, 1, THEME.Border, THEME.StrokeTrans)
end

