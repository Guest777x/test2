Medusa = {Conns={}, Debounce=false, Last=0, Cooldown=25}
function GD_StartMedusaCounter()
    GD_StopMedusaCounter()
    local c = LP.Character; if not c then return end
    local function onPart(p)
        if not p:IsA("BasePart") then return end
        table.insert(Medusa.Conns, p:GetPropertyChangedSignal("Anchored"):Connect(function()
            if Config.MedusaCounter and p.Anchored and p.Transparency==1 then
                if Medusa.Debounce or tick()-Medusa.Last<Medusa.Cooldown then return end
                local cc = LP.Character; if not cc then return end
                Medusa.Debounce = true
                local med
                for _,t in ipairs(cc:GetChildren()) do if t:IsA("Tool") then local n=t.Name:lower(); if n:find("medusa") or n:find("head") or n:find("stone") then med=t; break end end end
                local bp = LP:FindFirstChildOfClass("Backpack")
                if not med and bp then for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then local n=t.Name:lower(); if n:find("medusa") or n:find("head") or n:find("stone") then med=t; break end end end end
                if med then
                    if med.Parent~=cc then local h=cc:FindFirstChildOfClass("Humanoid"); if h then pcall(function() h:EquipTool(med) end) end; task.wait(0.05) end
                    pcall(function() med:Activate() end)
                    Medusa.Last = tick()
                end
                Medusa.Debounce = false
            end
        end))
    end
    for _,p in ipairs(c:GetDescendants()) do onPart(p) end
    table.insert(Medusa.Conns, c.DescendantAdded:Connect(onPart))
end
function GD_StopMedusaCounter()
    for _,cn in ipairs(Medusa.Conns) do pcall(function() cn:Disconnect() end) end
    Medusa.Conns = {}
    Medusa.Debounce = false
end

