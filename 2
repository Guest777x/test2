function GD_SetRowGlow(row, on)
    if not row then return end
    local st = row:FindFirstChild("RowStroke") or row:FindFirstChildOfClass("UIStroke")
    if not st then return end
    local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if on then
        TweenService:Create(st, info, { Transparency = 0.05, Thickness = 1.8, Color = THEME.Accent }):Play()
        TweenService:Create(row, info, { BackgroundColor3 = THEME.Raised, BackgroundTransparency = 0.3 }):Play()
    else
        TweenService:Create(st, info, { Transparency = 0.4, Thickness = 1, Color = THEME.Border }):Play()
        TweenService:Create(row, info, { BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.5 }):Play()
    end
end

function GD_KeybindBadge(parent, initial, offsetX, width, onChanged)
    local btn = Instance.new("TextButton")
    btn.Text = tostring(initial or "None")
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 10
    btn.TextColor3 = THEME.Text
    btn.BackgroundColor3 = THEME.Raised
    btn.BackgroundTransparency = 0.35
    btn.BorderSizePixel = 0
    btn.Size = UDim2.fromOffset(width or 42, 22)
    btn.Position = UDim2.new(1, offsetX, 0.5, -11)
    btn.AutoButtonColor = false
    btn.Parent = parent
    GD_Corner(btn, 6)
    GD_Stroke(btn, 1, THEME.BorderSoft, 0.35)
    local listening = false
    local current = tostring(initial or "None")
    btn.Activated:Connect(function()
        if listening then return end
        listening = true
        keybindCaptureActive = true
        btn.Text = "…"
        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            local kb = input.UserInputType == Enum.UserInputType.Keyboard
            local gp = input.UserInputType.Name:match("^Gamepad%d+$") ~= nil
            if not (kb or gp) then return end
            current = (kb and input.KeyCode.Name == "Escape") and "None" or input.KeyCode.Name
            btn.Text = current
            if onChanged then onChanged(current) end
            GD_SaveConfig()
            listening = false
            btn.Text = current
            conn:Disconnect()
            task.defer(function() keybindCaptureActive = false end)
        end)
    end)
    return btn, function() return current end
end

function GD_FormatNum(n)
    n = tonumber(n) or 0
    if math.abs(n - math.floor(n + 1e-9)) < 1e-9 then return tostring(math.floor(n + 0.5)) end
    return string.format("%.1f", n)
end

function GD_NumberBadge(parent, initial, offsetX, width, onChanged)
    local btn = Instance.new("TextButton")
    btn.Text = GD_FormatNum(initial)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 11
    btn.TextColor3 = THEME.Text
    btn.BackgroundColor3 = THEME.Raised
    btn.BackgroundTransparency = 0.35
    btn.BorderSizePixel = 0
    btn.Size = UDim2.fromOffset(width or 40, 22)
    btn.Position = UDim2.new(1, offsetX, 0.5, -11)
    btn.AutoButtonColor = false
    btn.Parent = parent
    GD_Corner(btn, 6)
    GD_Stroke(btn, 1, THEME.BorderSoft, 0.35)
    local current = GD_FormatNum(initial)
    btn.Activated:Connect(function()
        local box = Instance.new("TextBox")
        box.Text = current
        box.Font = Enum.Font.GothamBold
        box.TextSize = 11
        box.TextColor3 = THEME.Text
        box.BackgroundColor3 = THEME.Raised
        box.BackgroundTransparency = 0.2
        box.BorderSizePixel = 0
        box.Size = btn.Size
        box.Position = btn.Position
        box.ClearTextOnFocus = false
        box.TextXAlignment = Enum.TextXAlignment.Center
        box.Parent = parent
        GD_Corner(box, 6)
        GD_Stroke(box, 1, THEME.Accent, 0.2)
        btn.Visible = false
        box:CaptureFocus()
        box.CursorPosition = #box.Text + 1
        box.FocusLost:Connect(function()
            local num = tonumber((box.Text:gsub("%s+", ""):gsub(",", ".")))
            if num then
                num = math.floor(num * 10 + 0.5) / 10
                current = GD_FormatNum(num)
                if onChanged then onChanged(num) end
                GD_SaveConfig()
            end
            btn.Text = current
            box:Destroy()
            btn.Visible = true
        end)
    end)
    return btn, function() return tonumber(current) or 0 end, function(v)
        current = GD_FormatNum(v); btn.Text = current
    end
end

function GD_ToggleRow(parent, labelText, defaultOn, onToggle)
    local row = GD_Row(parent, labelText)
    local track = Instance.new("TextButton")
    track.Text = ""
    track.AutoButtonColor = false
    track.Size = UDim2.fromOffset(38, 20)
    track.Position = UDim2.new(1, -50, 0.5, -10)
    track.BackgroundColor3 = THEME.Raised
    track.BackgroundTransparency = 0.3
    track.BorderSizePixel = 0
    track.Parent = row
    GD_Corner(track, 10)
    local st = GD_Stroke(track, 1.4, THEME.BorderSoft, 0.3)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = defaultOn and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    knob.BackgroundColor3 = THEME.Text
    knob.BorderSizePixel = 0
    knob.Parent = track
    GD_Corner(knob, 7)
    local on = defaultOn == true
    local function setVisual(state)
        on = state == true
        local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(knob, info, {
            Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        }):Play()
        TweenService:Create(track, info, {
            BackgroundColor3 = on and THEME.Accent or THEME.Raised,
            BackgroundTransparency = on and 0.1 or 0.3,
        }):Play()
        TweenService:Create(st, info, {
            Color = on and THEME.Accent or THEME.BorderSoft,
            Transparency = on and 0 or 0.3,
            Thickness = on and 1.8 or 1.4,
        }):Play()
        GD_SetRowGlow(row, on)
    end
    track.Activated:Connect(function()
        setVisual(not on)
        if onToggle then onToggle(on) end
        GD_SaveConfig()
    end)
    return row, setVisual
end

