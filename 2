-- ============================================================
-- AUTO STEAL (full V1/V2/Semi with getconnections)
-- ============================================================
StealSys = {
    conn=nil, isStealing=false, stealStart=0, totalDuration=1.4, progressManual=false,
    data={}, animalCache={}, promptCache={}, scanLast=0,
}
function GD_StealIsMyPlot(name)
    local plots = workspace:FindFirstChild("Plots"); if not plots then return false end
    local plot = plots:FindFirstChild(name); if not plot then return false end
    local sign = plot:FindFirstChild("PlotSign")
    if sign then local yb = sign:FindFirstChild("YourBase"); if yb and yb:IsA("BillboardGui") then return yb.Enabled==true end end
    return false
end
function GD_StealFindNearestPrompt(radius)
    local c = LP.Character; if not c then return nil end
    local r = c:FindFirstChild("HumanoidRootPart"); if not r then return nil end
    local plots = workspace:FindFirstChild("Plots"); if not plots then return nil end
    local nearest, dist = nil, math.huge
    for _,plot in ipairs(plots:GetChildren()) do
        if not GD_StealIsMyPlot(plot.Name) then
            local pods = plot:FindFirstChild("AnimalPodiums")
            if pods then for _,pod in ipairs(pods:GetChildren()) do
                local base = pod:FindFirstChild("Base")
                local sp = base and base:FindFirstChild("Spawn")
                if sp then
                    local d = (sp.Position-r.Position).Magnitude
                    if d<=radius and d<dist then
                        local found = nil
                        local att = sp:FindFirstChild("PromptAttachment")
                        if att then for _,pr in ipairs(att:GetChildren()) do
                            if pr:IsA("ProximityPrompt") and pr.ActionText and pr.ActionText:find("Steal") then found=pr end
                        end end
                        if not found then for _,pr in ipairs(sp:GetDescendants()) do
                            if pr:IsA("ProximityPrompt") and pr.ActionText and pr.ActionText:find("Steal") then found=pr end
                        end end
                        if found then nearest, dist = found, d end
                    end
                end
            end end
        end
    end
    return nearest, dist
end
function GD_StealBuildCallbacks(prompt)
    if StealSys.data[prompt] then return StealSys.data[prompt] end
    local d = {hold={}, trigger={}, ready=true}
    if getconnections then pcall(function()
        for _,cn in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
            if cn.Function then table.insert(d.hold, cn.Function) end
        end
        for _,cn in ipairs(getconnections(prompt.Triggered)) do
            if cn.Function then table.insert(d.trigger, cn.Function) end
        end
    end) end
    StealSys.data[prompt] = d; return d
end
function GD_StealScanAnimals()
    local plots = workspace:FindFirstChild("Plots"); if not plots then return end
    local nc = {}
    for _,plot in ipairs(plots:GetChildren()) do
        if plot:IsA("Model") and not GD_StealIsMyPlot(plot.Name) then
            local pods = plot:FindFirstChild("AnimalPodiums")
            if pods then for _,pod in ipairs(pods:GetChildren()) do
                if pod:IsA("Model") and pod:FindFirstChild("Base") then
                    table.insert(nc, {
                        name=pod.Name, plot=plot.Name, slot=pod.Name,
                        worldPosition=pod:GetPivot().Position, uid=plot.Name.."_"..pod.Name,
                    })
                end
            end end
        end
    end
    StealSys.animalCache = nc
end
function GD_StealFindPromptForAnimal(ad)
    if not ad then return nil end
    local cp = StealSys.promptCache[ad.uid]
    if cp and cp.Parent then return cp end
    local plots = workspace:FindFirstChild("Plots"); if not plots then return nil end
    local plot = plots:FindFirstChild(ad.plot); if not plot then return nil end
    local pods = plot:FindFirstChild("AnimalPodiums"); if not pods then return nil end
    local pod = pods:FindFirstChild(ad.slot); if not pod then return nil end
    local base = pod:FindFirstChild("Base"); local sp = base and base:FindFirstChild("Spawn")
    if not sp then return nil end
    local prompt = nil
    local att = sp:FindFirstChild("PromptAttachment")
    if att then for _,p in ipairs(att:GetChildren()) do if p:IsA("ProximityPrompt") then prompt=p; break end end end
    if not prompt then for _,o in ipairs(sp:GetDescendants()) do if o:IsA("ProximityPrompt") then prompt=o; break end end end
    if prompt then StealSys.promptCache[ad.uid] = prompt end
    return prompt
end
function GD_StealNearestAnimal(radius)
    local c = LP.Character; if not c then return nil end
    local h = c:FindFirstChild("HumanoidRootPart"); if not h then return nil end
    local best, bd = nil, math.huge
    for _,ad in ipairs(StealSys.animalCache) do
        if ad.worldPosition then
            local d = (h.Position-ad.worldPosition).Magnitude
            if d<=radius and d<bd then bd=d; best=ad end
        end
    end
    return best, bd
end
function GD_StealExecuteV1(prompt)
    if StealSys.isStealing then return end
    local d = GD_StealBuildCallbacks(prompt); if not d.ready then return end
    d.ready=false; StealSys.isStealing=true; StealSys.stealStart=tick(); StealSys.totalDuration=1.3
    task.spawn(function()
        for _,fn in ipairs(d.hold) do task.spawn(fn) end
        task.wait(1.3)
        for _,fn in ipairs(d.trigger) do task.spawn(fn) end
        d.ready=true; StealSys.isStealing=false; StealSys.stealStart=0
    end)
end
function GD_StealExecuteV2(prompt, ad)
    if StealSys.isStealing or not Config.AutoSteal then return end
    local d = GD_StealBuildCallbacks(prompt); if not d.ready then return end
    d.ready=false; StealSys.isStealing=true; StealSys.progressManual=true; StealSys.stealStart=tick()
    local dur = 1.35
    local stopPct = tonumber(Config.AutoStealStopAt) or 75
    local th = math.clamp(stopPct, 75, 95)/100
    local nearD = th>=0.80 and 7 or 9.3
    local tToTh = math.max(0.05, dur*th)
    local tAfter = math.max(0.05, dur-tToTh)
    local waitMax = 1.6
    StealSys.totalDuration = dur
    task.spawn(function()
        for _,fn in ipairs(d.hold) do pcall(function() task.spawn(fn) end) end
        local start = tick()
        while tick()-start < tToTh do
            if not Config.AutoSteal or not StealSys.isStealing then
                d.ready=true; StealSys.isStealing=false; StealSys.progressManual=false; StealSys.stealStart=0; return
            end
            task.wait()
        end
        local function isNear()
            local c = LP.Character
            local h = c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso"))
            if not h then return false end
            if ad and ad.plot and ad.slot then
                local plots = workspace:FindFirstChild("Plots")
                local plot = plots and plots:FindFirstChild(ad.plot)
                local pods = plot and plot:FindFirstChild("AnimalPodiums")
                local pod = pods and pods:FindFirstChild(ad.slot)
                if pod then local ok,pos = pcall(function() return pod:GetPivot().Position end); if ok and pos then return (pos-h.Position).Magnitude<=nearD end end
            end
            return false
        end
        local still = isNear()
        if not still then
            local s = tick()
            while tick()-s < waitMax do
                if not Config.AutoSteal or not StealSys.isStealing then
                    d.ready=true; StealSys.isStealing=false; StealSys.progressManual=false; StealSys.stealStart=0; return
                end
                if isNear() then still=true; break end
                task.wait()
            end
            if not still then d.ready=true; StealSys.isStealing=false; StealSys.progressManual=false; StealSys.stealStart=0; return end
        end
        local rs = tick()
        while tick()-rs < tAfter do
            if not Config.AutoSteal or not StealSys.isStealing then
                d.ready=true; StealSys.isStealing=false; StealSys.progressManual=false; StealSys.stealStart=0; return
            end
            task.wait()
        end
        for _,fn in ipairs(d.trigger) do pcall(function() task.spawn(fn) end) end
        pcall(function()
            local rem = ReplicatedStorage:FindFirstChild("StealAnimal")
            if rem and ad then rem:FireServer(ad.name or ad.slot) end
            if prompt and prompt.Fire then pcall(function() prompt:Fire() end) end
        end)
        task.wait(0.05)
        d.ready=true; StealSys.isStealing=false; StealSys.progressManual=false; StealSys.stealStart=0
    end)
end
function GD_StealExecuteSemi(prompt, ad)
    if StealSys.isStealing then return end
    local d = GD_StealBuildCallbacks(prompt); if not d.ready then return end
    d.ready=false; StealSys.isStealing=true; StealSys.stealStart=tick()
    local HOLD_MIN=1.3; local HOLD_MAX=2.6; local RANGE=8; local ENTRY=0.3
    task.spawn(function()
        local function dist()
            if ad and ad.worldPosition then
                local c=LP.Character; local h=c and c:FindFirstChild("HumanoidRootPart")
                if h then return (h.Position-ad.worldPosition).Magnitude end
            end
            return math.huge
        end
        for _,fn in ipairs(d.hold) do task.spawn(fn) end
        task.wait(HOLD_MIN)
        if dist() > (tonumber(Config.AutoStealRadius) or 61) then
            d.ready=true; StealSys.isStealing=false; StealSys.stealStart=0; return
        end
        local already = dist()<=RANGE
        while true do
            local el = tick()-StealSys.stealStart
            if el>HOLD_MAX or not prompt.Parent or not Config.AutoSteal then break end
            if dist()>(tonumber(Config.AutoStealRadius) or 61) then
                d.ready=true; StealSys.isStealing=false; StealSys.stealStart=0; return
            end
            if dist()<=RANGE then
                if not already then task.wait(ENTRY) end
                for _,fn in ipairs(d.trigger) do task.spawn(fn) end
                break
            end
            task.wait()
        end
        task.wait(0.05)
        d.ready=true; StealSys.isStealing=false; StealSys.stealStart=0
    end)
end
function GD_StartAutoSteal()
    if StealSys.conn then return end
    GD_StealScanAnimals()
    StealSys.conn = RunService.Heartbeat:Connect(function()
        if not Config.AutoSteal then return end
        if os.clock() < (Config._AutoStealHitPauseUntil or 0) then return end
        if StealSys.isStealing then return end
        if tick()-StealSys.scanLast > 5 then StealSys.scanLast=tick(); GD_StealScanAnimals() end
        local r = tonumber(Config.AutoStealRadius) or 9
        local mode = Config.AutoStealMode
        if mode=="Semi" then
            local best, bd = nil, math.huge
            local c=LP.Character; local h=c and c:FindFirstChild("HumanoidRootPart")
            if h then for _,ad in ipairs(StealSys.animalCache) do
                if ad.worldPosition then
                    local d=(h.Position-ad.worldPosition).Magnitude
                    if d<=r and d<bd then bd=d; best=ad end
                end
            end end
            if best then local p = GD_StealFindPromptForAnimal(best); if p then GD_StealExecuteSemi(p,best) end end
            return
        end
        local v = Config.AutoStealVersion or "V1"; if v=="V3" then v="V2" end
        if v=="V2" then
            local t, d = GD_StealNearestAnimal(r); if not t then return end
            if d and d>r then return end
            local p = GD_StealFindPromptForAnimal(t); if p then GD_StealExecuteV2(p,t) end
        else
            local p = GD_StealFindNearestPrompt(r); if p then GD_StealExecuteV1(p) end
        end
    end)
end
function GD_StopAutoSteal()
    if StealSys.conn then StealSys.conn:Disconnect(); StealSys.conn=nil end
    StealSys.isStealing=false; StealSys.progressManual=false; StealSys.stealStart=0
end
