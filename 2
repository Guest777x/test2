UserInputService.InputBegan:Connect(function(input, processed)
    if keybindCaptureActive then return end
    local isKb = input.UserInputType==Enum.UserInputType.Keyboard
    local isPad = input.UserInputType.Name:match("^Gamepad%d+$") ~= nil
    if not (isKb or isPad) then return end
    local key = input.KeyCode.Name
    local function is(k) return k and k~="" and key:upper()==tostring(k):upper() end
    if is(Config.HideUIKey) then if Config.HideUI then GD_Restore() else GD_Minimize() end; return end
    if is(Config.DropKey) then pcall(GD_RunDrop); return end
    if is(Config.TPDownKey) then if not processed then pcall(GD_DoTPDown) end; return end
    if is(Config.InstaResetKey) then if not processed then pcall(GD_InstantReset) end; return end
    if is(Config.CarrySpeedKey) then carrySpeedEnabled=not carrySpeedEnabled; if carrySpeedEnabled then laggerModeEnabled=false; laggerCarryEnabled=false end; return end
    if is(Config.LaggerKey) then
        if laggerModeEnabled then laggerModeEnabled=false; laggerCarryEnabled=true
        elseif laggerCarryEnabled then laggerCarryEnabled=false
        else laggerModeEnabled=true; laggerCarryEnabled=false end
        return
    end
    if is(Config.BatAimbotKey) then
        Config.BatAimbot = not Config.BatAimbot; State.autoBatToggled = Config.BatAimbot
        if Config.BatAimbot then GD_StartBatAimbot() else GD_StopBatAimbot() end
        GD_SaveConfig(); return
    end
end)

