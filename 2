-- layout pass: recompute canvas + page heights from AbsoluteContentSize
function GD_RecomputeLayout()
    local active = pages[currentTab]
    if not active then return end
    local best = 0
    for _,pg in pairs(pages) do
        if pg.Visible then
            local sz = pg.AbsoluteSize.Y
            if sz > best then best = sz end
        end
    end
    for _,pg in pairs(pages) do
        pg.Size = UDim2.new(1,0,0, best)
    end
    content.CanvasSize = UDim2.new(0, 0, 0, best + 24)
end

function GD_SelectTab(name)
    currentTab = name
    for n, d in pairs(tabButtons) do
        local active = n==name
        TweenService:Create(d.btn, TweenInfo.new(0.15), {
            BackgroundColor3 = active and THEME.Accent or THEME.Panel,
            BackgroundTransparency = active and 0.15 or 0.35,
        }):Play()
        TweenService:Create(d.lbl, TweenInfo.new(0.15), {
            TextColor3 = active and THEME.Text or THEME.TextDim,
        }):Play()
        pages[n].Visible = active
    end
    content.CanvasPosition = Vector2.new(0,0)
    task.defer(GD_RecomputeLayout)
end

