-- BatCounter
BAT_SLAP = {"Bat","Slap","Iron Slap","Gold Slap","Diamond Slap","Emerald Slap","Ruby Slap","Dark Matter Slap","Flame Slap","Nuclear Slap","Galaxy Slap","Glitched Slap"}
BatCounter = {Conn=nil, Debounce=false, WasRag=false}
function GD_StartBatCounter()
    if BatCounter.Conn then return end
    local last=0
    BatCounter.Conn = RunService.Heartbeat:Connect(function()
        if not Config.BatCounter then BatCounter.WasRag=false; return end
        local c=LP.Character; local h=c and c:FindFirstChildOfClass("Humanoid")
        if not c or not h then return end
        local rag = h:GetState()==Enum.HumanoidStateType.Physics
        if not (rag and not BatCounter.WasRag) then BatCounter.WasRag=rag; return end
        BatCounter.WasRag = true
        if BatCounter.Debounce or os.clock()-last<0.1 then return end
        last=os.clock(); BatCounter.Debounce=true
        task.spawn(function()
            pcall(function()
                local cur=LP.Character; local r=cur and cur:FindFirstChild("HumanoidRootPart"); local h2=cur and cur:FindFirstChildOfClass("Humanoid")
                if not cur or not r or not h2 then return end
                local tr,bd = nil, math.huge
                for _,p in ipairs(Players:GetPlayers()) do
                    if p~=LP and p.Character then
                        local pr=p.Character:FindFirstChild("HumanoidRootPart"); local ph=p.Character:FindFirstChildOfClass("Humanoid")
                        if pr and ph and ph.Health>0 then local d=(pr.Position-r.Position).Magnitude; if d<bd then bd=d; tr=pr end end
                    end
                end
                if not tr then return end
                local bat; local bp=LP:FindFirstChildOfClass("Backpack")
                for _,n in ipairs(BAT_SLAP) do local t=cur:FindFirstChild(n) or (bp and bp:FindFirstChild(n)); if t then bat=t; break end end
                if not bat and bp then for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") and t.Name:lower():find("bat") then bat=t; break end end end
                if not bat then return end
                if bat.Parent~=cur then pcall(function() h2:EquipTool(bat) end); task.wait(0.015) end
                local tp=tr.Position; local flat=Vector3.new(tp.X, r.Position.Y, tp.Z)
                if (flat-r.Position).Magnitude>0.001 then h2.AutoRotate=false; r.CFrame=CFrame.lookAt(r.Position, flat) end
                task.wait(0.02)
                pcall(function() bat:Activate() end)
                task.wait(0.2)
                if r and r.Parent then pcall(function() r.RotVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero end) end
                if h2 and h2.Parent then h2.AutoRotate=true end
            end)
            BatCounter.Debounce=false
        end)
    end)
end
function GD_StopBatCounter()
    if BatCounter.Conn then BatCounter.Conn:Disconnect(); BatCounter.Conn=nil end
    BatCounter.Debounce=false; BatCounter.WasRag=false
end

