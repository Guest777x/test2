-- Speed / Velocity
GD_Speed = {}
do
    local S = { spoofed = Vector3.zero, root = nil, hooked = false, plane = Vector2.zero, lastMoveDir = Vector3.zero }
    local MOVE_KEYS = { [Enum.KeyCode.W]=true,[Enum.KeyCode.A]=true,[Enum.KeyCode.S]=true,[Enum.KeyCode.D]=true,
        [Enum.KeyCode.Up]=true,[Enum.KeyCode.Left]=true,[Enum.KeyCode.Down]=true,[Enum.KeyCode.Right]=true }
    local function ragdoll(h)
        if not h then return true end
        local st = h:GetState()
        return h.PlatformStand or st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll
            or st == Enum.HumanoidStateType.FallingDown
    end
    local function applyHRP(hrp, x, z)
        if not hrp or not hrp.Parent then return end
        local y = hrp.AssemblyLinearVelocity.Y
        hrp.AssemblyLinearVelocity = Vector3.new(x, y, z)
        local vis = math.min(math.sqrt(x*x + z*z), 20)
        if vis > 0.05 then
            local u = Vector3.new(x, 0, z)
            if u.Magnitude > 0.001 then u = u.Unit end
            S.spoofed = Vector3.new(u.X * vis, y, u.Z * vis)
        else
            S.spoofed = Vector3.new(0, y, 0)
        end
        S.plane = Vector2.new(x, z)
    end
    local function applySpeed(spd)
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then return end
        if State.autoBatToggled or Config.AutoLeft or Config.AutoRight or dropActive then return end
        if ragdoll(hum) then S.lastMoveDir = Vector3.zero; return end
        S.root = root
        local dir = nil
        if hum.MoveDirection.Magnitude > 0 then
            S.lastMoveDir = hum.MoveDirection
            dir = hum.MoveDirection
        elseif S.lastMoveDir.Magnitude > 0 then
            for k in pairs(MOVE_KEYS) do
                if UserInputService:IsKeyDown(k) then dir = S.lastMoveDir; break end
            end
        end
        if dir and dir.Magnitude > 0.05 then
            pcall(function() if root.SetNetworkOwner then root:SetNetworkOwner(LP) end end)
            local u = dir.Unit
            local y = root.AssemblyLinearVelocity.Y
            root.AssemblyLinearVelocity = Vector3.new(u.X * spd, y, u.Z * spd)
            local vis = math.min(spd, 20)
            S.spoofed = Vector3.new(u.X * vis, y, u.Z * vis)
            S.plane = Vector2.new(u.X * spd, u.Z * spd)
            S.lastMoveDir = u
        else
            local y = root.AssemblyLinearVelocity.Y
            root.AssemblyLinearVelocity = Vector3.new(0, y, 0)
            S.spoofed = Vector3.new(0, y, 0)
            S.plane = Vector2.zero
        end
    end
    -- metatable hook
    pcall(function()
        if not (getrawmetatable and setreadonly and newcclosure and checkcaller) then return end
        if S.hooked then return end
        local mt = getrawmetatable(game)
        if not mt then return end
        setreadonly(mt, false)
        local oi, oni = mt.__index, mt.__newindex
        local function mine(t, k)
            local tk = tostring(k)
            if tk ~= "AssemblyLinearVelocity" and tk ~= "Velocity" then return false end
            if typeof(t) ~= "Instance" or not t:IsA("BasePart") then return false end
            local n = t.Name
            if n ~= "HumanoidRootPart" and n ~= "Torso" and n ~= "UpperTorso" then return false end
            local c = LP.Character
            return c ~= nil and t:IsDescendantOf(c)
        end
        if type(oi) == "function" or type(oi) == "table" then
            mt.__index = newcclosure(function(self, k)
                if not checkcaller() then
                    local ok, m = pcall(mine, self, k); if ok and m then return S.spoofed end
                end
                if type(oi) == "function" then return oi(self, k) end
                return oi[k]
            end)
        end
        if type(oni) == "function" then
            mt.__newindex = newcclosure(function(self, k, v)
                if not checkcaller() then
                    local ok, m = pcall(mine, self, k); if ok and m then S.spoofed = v; return end
                end
                return oni(self, k, v)
            end)
        end
        setreadonly(mt, true)
        S.hooked = true
    end)
    GD_Speed.apply = applySpeed
    GD_Speed.getPlane = function() return S.plane end
    GD_Speed.clear = function()
        local c = LP.Character; local r = c and c:FindFirstChild("HumanoidRootPart")
        if r then local y = r.AssemblyLinearVelocity.Y; r.AssemblyLinearVelocity = Vector3.new(0, y, 0) end
        S.plane = Vector2.zero
    end
    GD_Speed.setXZ = function(hrp, x, z) applyHRP(hrp, x, z) end
end

function GD_GetActiveSpeed()
    local inLagger = laggerModeEnabled or laggerSpeedEnabled or laggerCarryEnabled
    if carrySpeedEnabled then
        return inLagger and (tonumber(Config.LaggerCarry) or 20) or (tonumber(Config.CarrySpeed) or 29)
    end
    if autoCarryBoost and Config.AutoCarrySpeed then
        return inLagger and (tonumber(Config.LaggerCarry) or 20) or (tonumber(Config.CarrySpeed) or 29)
    end
    if laggerCarryEnabled then return tonumber(Config.LaggerCarry) or 20 end
    if laggerModeEnabled or laggerSpeedEnabled then return tonumber(Config.LaggerSpeed) or 40 end
    return tonumber(Config.NormalSpeed) or 59
end

-- TP Down
function GD_GetLandingY(char, root, hum)
    local half = math.max(1, root.Size.Y * 0.5)
    local off = half * 3
    pcall(function()
        if hum.RigType == Enum.HumanoidRigType.R15 then off = half + (hum.HipHeight or half * 2) end
    end)
    if off ~= off or off < 1 or off > 12 then off = half * 3 end
    local ignored = {char}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then table.insert(ignored, p.Character) end
    end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = ignored
    pcall(function() rp.FilterType = Enum.RaycastFilterType.Exclude end)
    rp.IgnoreWater = true
    local castY = root.Position.Y - half - 0.1
    local floorY
    for _ = 1, 12 do
        local hit = workspace:Raycast(Vector3.new(root.Position.X, castY, root.Position.Z), Vector3.new(0, -4000, 0), rp)
        if not hit then break end
        local part = hit.Instance
        local skip = false
        pcall(function()
            if part:IsA("BasePart") and not part.CanCollide then skip = true end
            local m = part:FindFirstAncestorOfClass("Model")
            if m and m:FindFirstChildOfClass("Humanoid") then skip = true end
        end)
        if not skip then floorY = hit.Position.Y; break end
        table.insert(ignored, part)
        rp.FilterDescendantsInstances = ignored
        castY = hit.Position.Y - 0.05
    end
    return floorY and (floorY + off + 0.15) or -7
end

function GD_DoTPDown(force)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    if not force then
        if hum.FloorMaterial ~= Enum.Material.Air then return end
        if hrp.Position.Y < (tonumber(Config.TPDownHeight) or 20) then return end
    end
    local y = GD_GetLandingY(char, hrp, hum)
    local _, yaw = hrp.CFrame:ToEulerAnglesYXZ()
    local v = hrp.AssemblyLinearVelocity
    hrp.CFrame = CFrame.new(hrp.Position.X, y, hrp.Position.Z) * CFrame.Angles(0, yaw, 0)
    hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
    pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)
end

autoTPConn = nil
function GD_StartAutoTPDown()
    if autoTPConn then pcall(task.cancel, autoTPConn); autoTPConn = nil end
    autoTPConn = task.spawn(function()
        while Config.AutoTPDown do task.wait(0.1); pcall(GD_DoTPDown, false) end
        autoTPConn = nil
    end)
end
function GD_StopAutoTPDown()
    Config.AutoTPDown = false
    if autoTPConn then pcall(task.cancel, autoTPConn); autoTPConn = nil end
end

-- Instant Reset
GD_ResetCooldown = false
GD_LastResetRequest = 0
function GD_InstantReset()
    local now = os.clock()
    if now - GD_LastResetRequest < 0.75 or GD_ResetCooldown then return end
    GD_LastResetRequest = now
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    GD_ResetCooldown = true
    _G.GD_InstaResetting = true
    task.spawn(function()
        local savedHip = hum.HipHeight
        local savedRot = hum.AutoRotate
        local savedCol = {}
        local attempts = 0
        while attempts < 40 and char.Parent and hum.Parent and hum.Health > 0 do
            if LP.Character ~= char then break end
            pcall(function()
                hum.HipHeight = 1e30
                hum.AutoRotate = true
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then
                        if savedCol[p] == nil then savedCol[p] = p.CanCollide end
                        p.CanCollide = false
                    end
                end
            end)
            attempts += 1
            task.wait(0.05)
        end
        if char.Parent and hum.Parent and hum.Health > 0 and LP.Character == char then
            pcall(function() hum.Health = 0 end)
            task.wait(0.15)
        else
            pcall(function()
                hum.HipHeight = savedHip
                hum.AutoRotate = savedRot
                for p, c in pairs(savedCol) do if p and p.Parent then p.CanCollide = c end end
            end)
        end
        GD_ResetCooldown = false
        _G.GD_InstaResetting = false
    end)
end

