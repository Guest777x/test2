AntiLagState = {conn=nil, active=false, cache={}, lighting=nil, effects={}, beauty={}}
function GD_ALCache(inst, prop)
    local e = AntiLagState.cache[inst]; if not e then e={}; AntiLagState.cache[inst]=e end
    if e[prop]==nil then local ok,v = pcall(function() return inst[prop] end); if ok then e[prop]=v end end
end
function GD_ALObj(inst)
    if not AntiLagState.active then return end
    pcall(function()
        if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
            or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
            GD_ALCache(inst, "Enabled"); inst.Enabled = false
        elseif inst:IsA("BasePart") then
            GD_ALCache(inst, "CastShadow"); inst.CastShadow = false
            if inst.Material==Enum.Material.Glass or inst.Material==Enum.Material.ForceField then
                GD_ALCache(inst, "Material"); GD_ALCache(inst, "Reflectance")
                inst.Material = Enum.Material.SmoothPlastic; inst.Reflectance = 0
            end
        end
    end)
end
function GD_ALClearBeauty()
    for _,o in pairs(AntiLagState.beauty) do if o and o.Parent then pcall(function() o:Destroy() end) end end
    table.clear(AntiLagState.beauty)
end
function GD_ALEmotion()
