        local cc = LP.Character; local rr = cc and cc:FindFirstChild("HumanoidRootPart")
        if not rr or not dropActive then if conn then conn:Disconnect() end; dropActive=false; return end
        if tick()-t0 >= DROP_ASC then
            conn:Disconnect()
            pcall(function()
                local rp = RaycastParams.new(); rp.FilterDescendantsInstances={cc}; rp.FilterType=Enum.RaycastFilterType.Exclude
                local hit = workspace:Raycast(rr.Position, Vector3.new(0,-3000,0), rp)
