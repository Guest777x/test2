ESP = {esp=false, tr=false, conn=nil, objs={}, tracerGui=nil}
function GD_EnsureTracerGui()
    if ESP.tracerGui and ESP.tracerGui.Parent then return ESP.tracerGui end
    local sg = Instance.new("ScreenGui"); sg.Name="GDTracers"; sg.ResetOnSpawn=false
    sg.IgnoreGuiInset=true; sg.DisplayOrder=50; sg.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    pcall(function()
        if gethui then sg.Parent=gethui() else sg.Parent=game:GetService("CoreGui") end
    end)
    if not sg.Parent then sg.Parent=PlayerGui end
    ESP.tracerGui = sg; return sg
end
function GD_MakeTracer()
    local parent = GD_EnsureTracerGui()
    local f = Instance.new("Frame"); f.AnchorPoint=Vector2.new(0.5,0.5)
    f.BorderSizePixel=0; f.BackgroundColor3=THEME.Accent; f.Size=UDim2.fromOffset(0,1)
    f.Visible=false; f.ZIndex=10; f.Parent=parent
    GD_Corner(f,1); return f
end
function GD_UpdateTracer(fr, from, to)
    local dx, dy = to.X-from.X, to.Y-from.Y
    local d = math.sqrt(dx*dx+dy*dy)
    if d<1 then fr.Visible=false; return end
    fr.Size=UDim2.fromOffset(d,1)
    fr.Position=UDim2.fromOffset((from.X+to.X)*0.5,(from.Y+to.Y)*0.5)
    fr.Rotation=math.deg(math.atan2(dy,dx))
    fr.BackgroundColor3=THEME.Accent
    fr.Visible=true
end
function GD_UpdateESP(p)
    if not p or p==LP then return end
    local c = p.Character; local myChar = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local head = c and (c:FindFirstChild("Head") or hrp)
    local myH = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    local o = ESP.objs[p]; if not o then o={}; ESP.objs[p]=o end
    if not c or not hrp or not cam then
        if o.hl then o.hl.Enabled=false end
        if o.bb then o.bb.Enabled=false end
        if o.line then o.line.Visible=false end
        return
    end
    if ESP.esp then
        if not o.hl or not o.hl.Parent then
            pcall(function() if o.hl then o.hl:Destroy() end end)
            local hl = Instance.new("Highlight"); hl.Name="GDHL"
            hl.FillColor=THEME.Accent; hl.OutlineColor=THEME.Accent2
            hl.FillTransparency=0.45; hl.OutlineTransparency=0
            hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee=c; hl.Parent=c; o.hl=hl
        else o.hl.Enabled=true; o.hl.Adornee=c end
        if not o.bb or not o.bb.Parent then
            pcall(function() if o.bb then o.bb:Destroy() end end)
            local bb = Instance.new("BillboardGui")
            bb.Name="GDEsp"; bb.Size=UDim2.fromOffset(160,44); bb.StudsOffset=Vector3.new(0,2.4,0)
            bb.AlwaysOnTop=true; bb.MaxDistance=math.huge; bb.Adornee=head; bb.ResetOnSpawn=false
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then bb.Parent=pg else pcall(function()
                if gethui then bb.Parent=gethui() else bb.Parent=game:GetService("CoreGui") end
            end); if not bb.Parent then bb.Parent=head end end
            local nl=Instance.new("TextLabel"); nl.Size=UDim2.new(1,0,0,20); nl.BackgroundTransparency=1
            nl.Font=Enum.Font.GothamBlack; nl.TextSize=14; nl.TextColor3=THEME.Accent
            nl.TextStrokeTransparency=0.15; nl.TextStrokeColor3=Color3.new(0,0,0)
            nl.Text=p.DisplayName or p.Name or ""; nl.Parent=bb
            local sl=Instance.new("TextLabel"); sl.Size=UDim2.new(1,0,0,18); sl.Position=UDim2.new(0,0,0,20)
            sl.BackgroundTransparency=1; sl.Font=Enum.Font.GothamBold; sl.TextSize=13
            sl.TextColor3=THEME.Accent; sl.TextStrokeTransparency=0.15; sl.TextStrokeColor3=Color3.new(0,0,0)
            sl.Text="0"; sl.Parent=bb
            o.bb=bb; o.nl=nl; o.sl=sl
        else o.bb.Enabled=true; o.bb.Adornee=head; if o.nl then o.nl.Text=p.DisplayName or p.Name or "" end end
        if o.sl then
            local v = hrp.AssemblyLinearVelocity; local spd = Vector3.new(v.X,0,v.Z).Magnitude
            o.sl.Text = tostring(spd<0.5 and 0 or math.floor(spd+0.5))
        end
    else
        if o.hl then pcall(function() o.hl:Destroy() end); o.hl=nil end
        if o.bb then pcall(function() o.bb:Destroy() end); o.bb=nil; o.nl=nil; o.sl=nil end
    end
    if not myH then if o.line then o.line.Visible=false end; return end
    if not ESP.tr then if o.line then pcall(function() o.line:Destroy() end); o.line=nil end; return end
    if not o.line or not o.line.Parent then o.line = GD_MakeTracer() end
    local p1 = cam:WorldToViewportPoint(myH.Position)
    local p2 = cam:WorldToViewportPoint(hrp.Position)
    if p1.Z>0 and p2.Z>0 then
        local vs = cam.ViewportSize
        GD_UpdateTracer(o.line,
            Vector2.new(math.clamp(p1.X,-50,vs.X+50), math.clamp(p1.Y,-50,vs.Y+50)),
            Vector2.new(math.clamp(p2.X,-50,vs.X+50), math.clamp(p2.Y,-50,vs.Y+50)))
    else o.line.Visible=false end
end
function GD_RefreshESP()
    if not ESP.esp and not ESP.tr then
        for p,o in pairs(ESP.objs) do
            if o.hl then o.hl:Destroy() end
