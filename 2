function GD_CycleRow(parent, labelText, options, currentValue, onChanged, premium)
    local row=GD_Row(parent, labelText, premium)
    local lbl=Instance.new("TextLabel")
    lbl.BackgroundTransparency=1; lbl.Size=UDim2.fromOffset(120,24)
    lbl.Position=UDim2.new(1,-156,0.5,-12)
    lbl.Font=Enum.Font.GothamBold; lbl.TextSize=11; lbl.TextColor3=THEME.Text
    lbl.Text=tostring(currentValue); lbl.TextXAlignment=Enum.TextXAlignment.Center
    lbl.TextTruncate=Enum.TextTruncate.AtEnd; lbl.Parent=row
    local idx=1
    for i,o in ipairs(options) do if o==currentValue then idx=i; break end end
    local function arrow(txt,x)
        local b=Instance.new("TextButton"); b.Size=UDim2.fromOffset(26,24)
        b.Position=UDim2.new(1,x,0.5,-12)
        b.BackgroundColor3=THEME.Raised; b.BorderSizePixel=0
        b.Text=txt; b.Font=Enum.Font.GothamBlack; b.TextSize=13; b.TextColor3=THEME.Text
        b.AutoButtonColor=false; b.Parent=row; GD_Corner(b,6)
        return b
    end
    local function setIdx(i)
        if premium and not GD_PremiumAllowed() then GD_OpenTrialPrompt(); return end
        if i<1 then i=#options end
        if i>#options then i=1 end
        idx=i; lbl.Text=tostring(options[idx])
        if onChanged then onChanged(options[idx]) end
        GD_SaveConfig()
    end
    arrow("<",-190).Activated:Connect(function() setIdx(idx-1) end)
    arrow(">",-32).Activated:Connect(function() setIdx(idx+1) end)
    return row
end

function GD_ModeButtons(parent, options, current, onSelected)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,44)
    row.BackgroundColor3=THEME.Raised
    row.BackgroundTransparency=0.35
    row.BorderSizePixel=0; row.LayoutOrder=GD_NextOrder()
    row.Parent=parent
    GD_Corner(row,10); GD_Stroke(row,1,THEME.BorderSoft,0.3)
    GD_Padding(row,6,6,6,6)
    local lay=Instance.new("UIListLayout"); lay.FillDirection=Enum.FillDirection.Horizontal
    lay.SortOrder=Enum.SortOrder.LayoutOrder; lay.Padding=UDim.new(0,6); lay.Parent=row
    local n=math.max(#options,1)
    local btns={}
    local function refresh()
        for opt,b in pairs(btns) do
            local active=opt==current
            TweenService:Create(b, TweenInfo.new(0.12), {
                BackgroundColor3 = active and THEME.Accent or THEME.Panel,
                BackgroundTransparency = active and 0.15 or 0.35,
            }):Play()
        end
    end
    for _,opt in ipairs(options) do
        local b=Instance.new("TextButton"); b.Text=opt
        b.Font=Enum.Font.GothamBold; b.TextSize=11
        b.TextColor3=THEME.Text; b.AutoButtonColor=false
        b.Size=UDim2.new(1/n,-math.floor(6*(n-1)/n),1,0)
        b.BackgroundColor3 = opt==current and THEME.Accent or THEME.Panel
        b.BackgroundTransparency = opt==current and 0.15 or 0.35
        b.BorderSizePixel=0; b.Parent=row; GD_Corner(b,7)
        btns[opt]=b
        b.Activated:Connect(function()
            if current==opt then return end
            current=opt; refresh()
            if onSelected then onSelected(opt) end
            GD_SaveConfig()
        end)
    end
    refresh()
    return row
end

